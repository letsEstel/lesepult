ccusative definite plural"]],"niederbayer":[["Niederbayerin","masculine"]],"niederbayers":[["Niederbayer","genitive singular"],["Niederbayer","genitive"]],"niederbayerin":[["Niederbayer","feminine"]],"niederbayern":[["Niederbayer","dative definite plural"]]},"x":{"niederbayerisch":{"l":["Ein Güterschiff hat sich auf der Donau im niederbayerischen Osterhofen (Landkreis Deggendorf) festgefahren.","Bei seiner Nebentätigkeit unterstützt ihn ein Zuchthof im niederbayerischen Rottenburg-Pattendorf.","Er sei tief verwurzelt gewesen in der niederbayerischen Kultur und der Kraft des Dialekts, getragen von unverbrüchlichem Humor."]},"niederbrennen":{"t":[["Das Haus ist durch ein Feuer völlig niedergebrannt.","The house was completely burnt down by a fire."],["Tom drohte, Marias Haus niederzubrennen.","Tom threatened to burn Mary's house down."],["Sein Haus wurde niedergebrannt.","His house was burnt down."],["Bis die Feuerwehr eintraf, war das ganze Haus schon niedergebrannt.","Before the fire engine arrived, the whole house had burnt down."]],"l":["Wenn dieser Körper ein Haus wäre, würde ich es niederbrennen, singt Nemo.","Fängt euer Lager Feuer, kann es in wenigen Minuten vollständig niederbrennen.","Waldbrunn (dpa/lsw) - Ein Ferienhaus in Waldbrunn (Neckar-Odenwald-Kreis) ist bei einem Feuer niedergebrannt."]},"Niederbayern":{"l":["Die Polizei in Niederbayern berichtete, dass sich das Unwettergeschehen bisher weitestgehend im Rahmen hielt.","Ein Sprecher des Polizeipräsidiums Niederbayern sagte am Nachmittag: »Die Unwetterlage läuft bislang sehr glimpflich ab«.","Zwei große Hunde haben in Niederbayern einen Chihuahua totgebissen."]},"niederbrechen":{"l":["Jonas Roth (l.) und Tim Schneider haben mit dem FCA Niederbrechen bei der SG Selters/Erbach einen kniffligen Rückrunden-Auftakt vor sich."]},"Niederbergisch":{"l":["Der personell gebeutelte Niederbergische HC musste sich der SG Langenfeld geschlagen geben."]},"Niederbayerin":{"l":["Und der Niederbayer Aiwanger stellte nach den Zuwächsen bei der Bayern-Wahl 2023 neue Forderungen."]},"Niederbayer":{"l":["Die Polizei in Niederbayern berichtete, dass sich das Unwettergeschehen bisher weitestgehend im Rahmen hielt.","Ein Sprecher des Polizeipräsidiums Niederbayern sagte am Nachmittag: »Die Unwetterlage läuft bislang sehr glimpflich ab«.","Zwei große Hunde haben in Niederbayern einen Chihuahua totgebissen."]}}}