:[["Plexiglasscheibe","plural"],["Plexiglasscheibe","definite nominative plural"],["Plexiglasscheibe","definite genitive plural"],["Plexiglasscheibe","dative definite plural"],["Plexiglasscheibe","accusative definite plural"]],"plenums":[["Plenum","genitive"],["Plenum","genitive singular"]],"plenen":[["Plenum","plural"],["Plenum","definite nominative plural"],["Plenum","definite genitive plural"],["Plenum","dative definite plural"],["Plenum","accusative definite plural"]],"plena":[["Plenum","plural"],["Plenum","definite nominative plural"],["Plenum","definite genitive plural"],["Plenum","dative definite plural"],["Plenum","accusative definite plural"]]},"x":{"Plexiglas":{"l":["Aber warum kaufen viele Touristen noch heute, 35 Jahre später, Einzelteile der Mauer in auf Plexiglas oder in einer Schneekugel geklebt?"]},"pleite":{"t":[["Hast du gesagt, daß du pleite seist?","Did you say you were broke?"],["Habt ihr gesagt, daß ihr pleite seiet?","Did you say you were broke?"],["Haben Sie gesagt, daß Sie pleite seien?","Did you say you were broke?"],["Die Firma steht kurz vor der Pleite.","The company is on the edge of bankruptcy."]],"l":["Nach der Pleite zum Start wirkte der gebürtige Düsseldorfer schon etwas ratlos.","Nach der Scheidung wieder ein versuchter Drogenentzug, aber Whitney ist jetzt pleite.","Zweitgrößte Pleite des Jahres war der Konkurs des Kleidungsherstellers Schneiders in Salzburg-Liefering."]},"Pleite":{"t":[["Hast du gesagt, daß du pleite seist?","Did you say you were broke?"],["Habt ihr gesagt, daß ihr pleite seiet?","Did you say you were broke?"],["Haben Sie gesagt, daß Sie pleite seien?","Did you say you were broke?"],["Die Firma steht kurz vor der Pleite.","The company is on the edge of bankruptcy."]],"l":["Nach der Pleite zum Start wirkte der gebürtige Düsseldorfer schon etwas ratlos.","Nach der Scheidung wieder ein versuchter Drogenentzug, aber Whitney ist jetzt pleite.","Zweitgrößte Pleite des Jahres war der Konkurs des Kleidungsherstellers Schneiders in Salzburg-Liefering."]},"Plektrum":{"l":["Nun, wie auf dem Bild zu sehen ist, hat er ein schwarzes Plektrum in den Schlitz gesteckt."]},"plemplem":{"t":[["Er ist total plemplem.","He is as nutty as a fruitcake."],["Tom ist total plemplem.","Tom is as nutty as a fruitcake."]]},"Pleonasmus":{"t":[["„Schwarze Finsternis“ ist ein Beispiel für einen Pleonasmus.","A black darkness is an example of a pleonasm."]]},"Plenarsaal":{"l":["Am Arm des Bundespräsidenten betritt Ingeborg Schäuble den Plenarsaal des Bundestags.","Das Landesfinale findet traditionell im Plenarsaal des Landtags statt.","Höhepunkt war die abschließende Debatte im Plenarsaal, die von Mitgliedern des realen Bundestagspräsidium geleitet wurde."]},"Plebejer":{"b":[["Während im »ständischen« Verband der Herr mit Hilfe einer eigenständigen »Aristokratie« herrscht, also mit ihr die Herrschaft teilt, stützt er sich hier entweder auf Haushörige oder auf Plebejer: besitzlose, der eigenen sozialen Ehre entbehrende Schichten, die materiell gänzlich an ihn gekettet sind und keinerlei konkurrierende eigene Macht unter den Füßen haben.","在「等级制」团体中，主人借助一个独立的「贵族阶层」来统治，也就是与它分享统治权；而在这里，他依靠的要么是家奴，要么是平民：没有财产、没有自身社会荣誉的阶层，他们在物质上完全拴在他身上，脚下没有任何可以与他竞争的自身力量。","weber-politik~s-k2-4-1","以政治为业"]]},"Plenarsitzung":{"l":["Landtagsvizepräsident Tobias Reiß (CSU) rügte damit Halembas Wortwahl in einer laufenden Plenarsitzung.","Björn Höcke AfD bei einer Plenarsitzung des Thüringer Landtags.","Zu Beginn der Plenarsitzung wollen die Abgeordneten in einer Schweigeminute der Opfer des Anschlags gedenken."]},"Plettenberg":{"l":["Plettenberg berichtete weiter: „Das Profil Davies wird jetzt bei Manchester United erstellt.","Doch wer Falk von Plettenberg nach dem Grund fragte, der hatte sofort Verständnis.","Wie Plettenberg auf ) schreibt, sei Mukiele aber ein interessantes Ziel für Trainer Tuchel und Sportdirektor Christoph Freund."]},"Plettenberger":{"l":["Parallel dazu laden die Plettenberger Einzelhändler zum Candlelight-Shopping ein."]},"Plenum":{"l":["Die Regierungsfraktionen haben im letzten Plenum eine Änderung des Gaswirtschaftsgesetz eingebracht.","Für eine Bestätigung im Plenum reichte sogar eine einfache Mehrheit der abgegebenen Stimmen aus.","Wer die Vorbereitungen zu diesem Plenum verfolgte, der wusste, dass einige elementare Reformen im Gespräch waren."]}}}