,["Kombinat","accusative definite plural"],["Kombinat","accusative genitive nominative plural"]],"kombinaten":[["Kombinat","dative definite plural"],["Kombinat","dative plural"]],"kombiwagens":[["Kombiwagen","genitive"],["Kombiwagen","genitive singular"]],"kombiwägen":[["Kombiwagen","plural"],["Kombiwagen","definite nominative plural"],["Kombiwagen","definite genitive plural"],["Kombiwagen","dative definite plural"],["Kombiwagen","accusative definite plural"]]},"x":{"Kombination":{"t":[["Die Kombination ist die Poesie des Schachs.","The combination is the poetry of chess."],["Tom hat die Kombination des Tresors vergessen.","Tom forgot the safe's combination."],["Nordische Kombination verbindet zwei Wettbewerbe, Skisprung und Langlauf.","Nordic Combined is held as a combination of two events, ski-jump and cross-country ski."],["Wie lautet die Kombination des Safes?","What is the combination of the safe?"]],"l":["Eine Kombination aus Zitterpappelblättern, Eschenrinde und echtem Goldrutenkraut findet bei Weichteilrheuma Anwendung.","In Slalom, Super G und Kombination führte an ihm kein Weg vorbei.","Seine opulente Kombination aus floralen und warmen Noten schafft eine faszinierende Duftkomposition."],"b":[["Aber es kann heute auf die höchst verwickelten Abwandlungen, Übergänge und Kombinationen dieser reinen Typen nicht eingegangen werden: das gehört zu den Problemen der »allgemeinen Staatslehre«.","不过，今天没法深入讨论这些纯粹类型极其复杂的变体、过渡形态和组合：那是「一般国家学」的问题。","weber-politik~s-k1-7-5","以政治为业"]]},"kombinieren":{"t":[["Kreativität ist die Fähigkeit, bekannte Elemente in ungewohnter Weise zu kombinieren.","Creativity is the ability to combine familiar elements in unusual ways."],["Kreativität ist die Fähigkeit, bekannte Elemente in neuer, ungewohnter Weise zu kombinieren.","Creativity is the ability to combine known elements in a new and unusual way."],["Es ist ein Glücksfall, dass ich mein theoretisches Studium mit einer praktischen Ausbildung kombinieren kann.","It's a stroke of luck that I can combine my theoretical studies with practical training."],["Eine Idee kann dein ganzes Leben verändern. Wenn wir unsere Ideen kombinieren, können wir die ganze Welt verändern.","An idea can change your whole life. If we put our ideas together, we can change the whole world."]],"l":["Er kombinierte Natriumikat, das beim Kochen der Wäsche fein perlenden Sauerstoff freisetzt.","Kombiniert mit Auslandsaufenthalten falle es ihr nun aber leicht, andere Perspektiven einzunehmen.","Kombiniert mit schlichten oder auffälligeren Westen, ist jeder männliche Wiesn-Besucher gut angezogen."]},"kombinierbar":{"l":["Alle Flüge von Ryanair sind demnächst direkt bei Tui buchbar und mit den Reiseangeboten des Veranstalters kombinierbar, teilte der Konzern aus Hannover mit."]}}}