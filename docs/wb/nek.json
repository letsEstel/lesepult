singular strong"]],"nekrotischen":[["nekrotisch","genitive masculine singular strong without-article"],["nekrotisch","genitive neuter singular strong without-article"],["nekrotisch","dative plural strong without-article"],["nekrotisch","accusative masculine singular strong without-article"],["nekrotisch","definite includes-article nominative plural weak"],["nekrotisch","definite genitive includes-article masculine singular weak"],["nekrotisch","definite feminine genitive includes-article singular weak"],["nekrotisch","definite genitive includes-article neuter singular weak"]],"nekrotischem":[["nekrotisch","dative masculine singular strong without-article"],["nekrotisch","dative neuter singular strong without-article"],["nekrotisch","dative masculine neuter singular strong"]],"nekrologes":[["Nekrolog","genitive"],["Nekrolog","genitive singular"]],"nekrologs":[["Nekrolog","genitive"],["Nekrolog","genitive singular"]],"nekrologe":[["Nekrolog","plural"],["Nekrolog","definite nominative plural"],["Nekrolog","definite genitive plural"],["Nekrolog","dative singular"],["Nekrolog","accusative definite plural"]],"nekrologen":[["Nekrolog","dative definite plural"]]},"x":{"Nektarine":{"t":[["Wir haben zur Zeit Blaubeeren, Brombeeren, Kirschen, Erdbeeren, Pfirsiche und Nektarinen.","Right now, we have blueberries, blackberries, cherries, strawberries, peaches and nectarines."],["Wir haben derzeit Brom-, Blau- und Erdbeeren sowie Kirschen, Pfirsiche und Nektarinen.","Right now, we have blueberries, blackberries, cherries, strawberries, peaches and nectarines."]]},"Nektar":{"t":[["Honig entsteht aus Nektar, nicht aus Blütenstaub.","Honey is made from nectar, not pollen."],["Tom versuchte, der Götter Nektar und Ambrosia zu stehlen.","Tom tried to steal the gods' nectar and ambrosia."],["Die kräftigen Farben der Blütenblätter lockten Bienen zum Schmausen des Nektars.","The vivid colors of the petals attracted bees to feast on the nectar."]],"l":["Das Forschungsteam um Lai beobachtete schon länger, wie die Wildhunde Nektar von den afrikanischen Fackellilienblüten schleckten.","Seine sternförmige Einzelblüte schmückt jedes Beet über Wochen und nährt Schmetterlinge, Hummeln und Wildbienen mit Nektar und Pollen.","Da die toten Hummeln vor allem unter Silberlinden gefunden werden, dachte man lange Zeit, der Nektar dieser Lindenart könnte für die Hummeln giftig sein."]}}}