en"],"davontrügt":["davontragen"],"davorgehalten":["davorhalten"],"davorhaltend":["davorhalten"],"davorzuhalten":["davorhalten"],"davorhalte":["davorhalten"],"davorhältst":["davorhalten"],"davorhaltet":["davorhalten"],"davorhaltest":["davorhalten"],"davorhält":["davorhalten"],"davorhielt":["davorhalten"],"davorhielten":["davorhalten"],"davorhielte":["davorhalten"],"davorhieltest":["davorhalten"],"davorhieltst":["davorhalten"],"davorhieltet":["davorhalten"],"davorhalten":["davorhalten"],"davongereist":["davonreisen"],"davonreisend":["davonreisen"],"davonzureisen":["davonreisen"],"davonreise":["davonreisen"],"davonreist":["davonreisen"],"davonreisest":["davonreisen"],"davonreiset":["davonreisen"],"davonreiste":["davonreisen"],"davonreisten":["davonreisen"],"davonreistest":["davonreisen"],"davonreistet":["davonreisen"]},"x":{"davon":{"t":[["Du solltest doch niemandem etwas davon sagen!","I thought that you weren't supposed to tell anybody about that."],["Ihr solltet doch niemandem etwas davon sagen!","I thought that you weren't supposed to tell anybody about that."],["Sie sollten doch niemandem etwas davon sagen!","I thought that you weren't supposed to tell anybody about that."],["Ich würde davon abraten, das zu tun.","I'd advise against doing that."]],"l":["Wie die Partner davon profitieren sollen, führt Xerox allerdings nicht näher aus.","Wir gehen davon aus, dass es auch dieses Mal so laufen kann.","Wir werden sehen, was wir davon haben werden“, fügte der Staatschef hinzu."],"b":[["Eine Wittwe hatte zwei Töchter, davon war die eine schön und fleißig, die andere häßlich und faul.","有个寡妇有两个女儿，其中一个又漂亮又勤快，另一个又丑又懒。","grimm~s-k024-0-0","格林童话（读本）"],["Gewaltsamkeit ist natürlich nicht etwa das normale oder einzige Mittel des Staates: – davon ist keine Rede –, wohl aber: das ihm spezifische.","暴力当然不是国家正常的或唯一的手段，绝对不是这个意思；但它是国家特有的手段。","weber-politik~s-k1-3-0","以政治为业"],["Davon ist natürlich gar keine Rede.","当然根本谈不上这一点。","weber-politik~s-k3-8-2","以政治为业"]]},"David":{"t":[["David hat die Ergebnisse des DNS-Tests gefunden.","David found the results of the DNA test."],["David arbeitete in einer preiswerten kleinen Imbißstube.","David was working at a cheap little diner."],["David hat online mit seinen Followern geredet.","David was talking to his followers online."],["David und Amanda waren als Kinder befreundet.","David and Amanda used to be friends when they were kids."]],"l":["David Raum (l.) war nach dem EM-Aus der deutschen Nationalmannschaft ziemlich geknickt.","Eine Freundesgruppe aus der Nähe von Stuttgart freut sich auf Shirin David.","US-Außenminister Antony Blinken äußerte sich wie sein britischer Amtskollege David Cameron ähnlich."],"b":[["Ich gestehe frei: die Erinnerung des David Hume war eben dasjenige, was mir vor vielen Jahren zuerst den dogmatischen Schlummer unterbrach, und meinen Untersuchungen im Felde der spekulativen Philosophie eine ganz andre Richtung gab.","我坦白承认：正是大卫·休谟的提醒，在多年以前第一次打断了我独断论的迷梦，并给了我在思辨哲学领域的研究一个完全不同的方向。","kant-prolegomena~s-5-0","未来形而上学导论 · 序言（上）"],["Seit Lockes und Leibnizens Versuchen, oder vielmehr seit dem Entstehen der Metaphysik, soweit die Geschichte derselben reicht, hat sich keine Begebenheit zugetragen, die in Ansehung des Schicksals dieser Wissenschaft hätte entscheidender werden können, als der Angriff, den David Hume auf dieselbe machte.","自从洛克和莱布尼茨的尝试以来，或者不如说，自从形而上学诞生以来，就它的历史所及，再没有发生过哪一件事，比大卫·休谟对它的攻击对这门科学的命运更具决定性。","kant-prolegomena~s-2-0","未来形而上学导论 · 序言（上）"]]},"davor":{"t":[["Habt ihr Angst davor, allein zu sterben?","Are you scared of dying alone?"],["Haben Sie Angst davor, allein zu sterben?","Are you scared of dying alone?"],["Ich warnte Tom davor, nachts allein hinauszugehen.","I warned Tom not to go out at night alone."],["Tom hat keine Angst davor zu verlieren.","Tom isn't afraid of losing."]],"l":["Kürzlich gab es neue Farbe, davor ist die Dachterrasse komplett erneuert worden.","Philipp Hildebrand warnt jedoch davor, die Notenbank mit neuen Aufgaben zu überfordern.","Und sprach davor noch über Freiheit, Verantwortung, Syrien, Polen, Krems - und Kärtnen."],"b":[["Sie lief und wollte sehen wer draußen wäre, als sie aber aufmachte, so saß der Frosch davor.","她跑过去想看看外面是谁，可是一开门，青蛙就坐在门前。","grimm~s-k001-2-1","格林童话（读本）"],["Sein Sohn und dessen Frau ekelten sich davor, und deswegen mußte sich der alte Großvater endlich hinter den Ofen in die Ecke setzen, und sie gaben ihm sein Essen in ein irdenes Schüsselchen und noch dazu nicht einmal satt; da sah er betrübt nach dem Tisch, und die Augen wurden ihm naß.","他的儿子和儿媳嫌恶心，所以老祖父最后只好坐到炉子后面的角落里去。他们把饭盛在一个陶土小碗里给他，而且还不让他吃饱。他难过地望着饭桌，眼泪湿了眼眶。","grimm~s-k078-0-2","格林童话（读本）"]]},"davonlaufen":{"t":[["Jetzt kannst du mir nicht mehr davonlaufen.","You can't run away from me now."],["Er weiß, dass ihm die Zeit davonläuft.","He knows he's running out of time."],["Man kann nicht vor seiner Vergangenheit davonlaufen.","You can't run from the past."],["Maria weiß, daß ihr die Zeit davonläuft.","Mary knows she's running out of time."]],"l":["Kurz darauf sprang er aus dem Fluchtfahrzeug und versuchte davonzulaufen.","Und schon seien die drei „Jungs“ wieder davongelaufen.","Sie zeigten ihn, wie er mit zwei Kätzchen im Arm vor schwarzen Männern mit nacktem Oberkörper davonläuft."]},"Davos":{"l":["Die Tourismusbehörde von Davos wollte die Angelegenheit zunächst nicht auf Anfrage kommentieren.","Und es wird klar: Auch Davos hat noch viel Arbeit vor sich.","Auftritte in Bern und Davos Selenski und die Schweiz – ist das noch neutral?"]},"davonfahren":{"t":[["Tom hörte Marias Wagen davonfahren.","Tom heard Mary's car drive off."],["Er ist mit Vollgas davongefahren, ohne dass er gesagt hätte, wohin.","He took off at full speed without saying where he was going."]],"l":["Dieser sei aus dem Wasser gestiegen und mit dem Fahrrad davongefahren.","Der Mann sei dann mit hoher Geschwindigkeit davongefahren.","Die vier waren zuvor in eine Polizeikontrolle in der Innenstadt geraten, Anhaltezeichen aber ignorierten und davonfuhren."]},"davonkommen":{"t":[["Glaube nicht, dass ich dich davonkommen lasse!","Don't think that I'm going to let you get away."],["Glaubt nicht, dass ich euch davonkommen lasse!","Don't think that I'm going to let you get away."],["Diesmal wirst du nicht ohne Strafe davonkommen.","This time, you won't avoid being punished."],["Glaubst du wirklich, dass du damit davonkommst?","Do you really think you can get away with this?"]],"l":["Nur darum sind wir mit einem blauen Auge davongekommen.","Der 27-Jährige könnte auch wegen dieser Kooperation mit einer Bewährungsstrafe davonkommen.","Doch so einfach wollte die SPÖ den blauen Parteichef in den Monaten vor der Wahl nicht davonkommen lassen."]},"Davidstern":{"t":[["Er sprühte einen Davidstern an die Tunnelwand.","He spray-painted a Star of David onto the wall of the tunnel."]],"l":["Wie sie den Davidstern verstecken, ihren Namen vom Klingelschild nehmen.","Zentrale gestalterische Elemente sind Spitzbögen sowie ein einzigartiges Kunstwerk, das Symbole der fünf Weltreligionen wie Kreuz, Halbmond und Davidstern enthält."]},"davonmachen":{"t":[["Jemand hat sich mit der Milch davongemacht.","Someone's made off with the milk."],["Erledige ihn, ehe er sich davonmacht!","Finish him off before he gets away."],["Kurzum hat er sich davongemacht, ohne seine Schulden zu begleichen.","In short, he's run off without paying off his debt."],["Tom lugte aus dem Fenster, um zu sehen, ob er sich sicher davonmachen könne.","Tom peeked out the window to see if it was safe to leave."]],"l":["Als die beiden dann jedoch am Ziel ankamen und der Passagier am Parkplatz „Zum Königsstuhl“ ausstieg, wollte er sich davonmachen, ohne zu bezahlen."]},"davonrennen":{"t":[["Der Dieb ist mit meiner Tasche davongerannt.","The thief ran off with my bag."],["Diese Feiglinge sind gleich davongerannt.","Those cowards ran away soon."],["Tom ist vor Mary davongerannt.","Tom ran away from Mary."]],"l":["Davongerannt ist ein betrunkener Autofahrer (23) nach einem schweren Unfall Sonntagfrüh auf der Vorchdorfer Straße in Pettenbach (Bezirk Kirchdorf).","Sie habe nicht zulassen können, dass ihr etwas zustößt, aber gleichzeitig habe sie nicht einfach davonrennen können - was sie eigentlich tun wollte."]},"davongerannt":{"t":[["Der Dieb ist mit meiner Tasche davongerannt.","The thief ran off with my bag."],["Diese Feiglinge sind gleich davongerannt.","Those cowards ran away soon."],["Tom ist vor Mary davongerannt.","Tom ran away from Mary."]],"l":["Davongerannt ist ein betrunkener Autofahrer (23) nach einem schweren Unfall Sonntagfrüh auf der Vorchdorfer Straße in Pettenbach (Bezirk Kirchdorf)."]},"davongelaufen":{"t":[["Ein großes Tier ist dem Zoo davongelaufen.","A big animal ran away from the zoo."],["Mit wem ist Tom davongelaufen?","Who did Tom run away with?"]],"l":["Und schon seien die drei „Jungs“ wieder davongelaufen.","Auf der Flucht vor dem Tier sei das Paar in unterschiedliche Richtungen davongelaufen, so der Bericht weiter."]},"davontragen":{"t":[["Mehrere Häuser wurden von der Flut davongetragen.","Several houses were carried away by the great flood."],["Ich habe im Wald etliche Insektenstiche davongetragen.","I got a lot of insect bites in the woods."],["Toms Katze wurde von einem Tornado davongetragen.","Tom's cat was carried away by a tornado."],["Wir haben diesmal den Sieg davongetragen.","We won this time."]],"l":["Viele Kinder und Jugendliche haben dadurch Konsequenzen davongetragen, wie etwa psychische Belastungen.","Fünf Gäste hätten bei dem Vorfall auf der Spree nur leichte Verletzungen davongetragen.","Wie sie durch die Schläge der Männer Hämatome, blaue Flecken und Wunden davontrugen."]}}}