[["Besucherbereich","dative definite plural"],["Besucherbereich","dative plural"]],"besuchsmöglichkeiten":[["Besuchsmöglichkeit","plural"],["Besuchsmöglichkeit","definite nominative plural"],["Besuchsmöglichkeit","definite genitive plural"],["Besuchsmöglichkeit","dative definite plural"],["Besuchsmöglichkeit","accusative definite plural"]],"besuchszeiten":[["Besuchszeit","plural"],["Besuchszeit","definite nominative plural"],["Besuchszeit","definite genitive plural"],["Besuchszeit","dative definite plural"],["Besuchszeit","accusative definite plural"]],"besungen":[["besingen","participle past"]]},"x":{"Besuch":{"t":[["Wir kommen morgen auf einen Besuch vorbei.","We're coming for a visit tomorrow."],["Hattet ihr Zeit, den Dom zu besuchen?","Did you have time to visit the cathedral?"],["Unsere Kinder wollen heute den Tiergarten besuchen.","Our children want to visit the zoo today."],["Wie viele Besucher besuchen jedes Jahr München?","How many visitors visit Munich every year?"]],"l":["Vor allem am Adventswochenende bietet sich ein Besuch auf dem Weihnachtsmarkt an.","Wer auf sein Handy beim Besuch verzichtet, bekommt eine Flasche Wein gratis.","Zentraler Programmpunkt der Fahrt soll ein Besuch des Museums für Bestattungskultur sein."],"b":[["Preußischer Kultusminister konnte man schon unter dem alten Regime sein, ohne selbst jemals eine höhere Unterrichtsanstalt besucht zu haben, während man Vortragender Rat grundsätzlich nur auf Grund der vorgeschriebenen Prüfungen werden konnte.","早在旧政权下，一个人可以当普鲁士文化部长，自己却从未上过高等学校；而要当一名报告参事，原则上必须通过规定的考试。","weber-politik~s-k3-20-1","以政治为业"]]},"besudeln":{"t":[["Wer Pech angreift, der besudelt sich damit.","He who touches pitch shall be defiled therewith."],["Die Heiligkeit dieses Ortes ist besudelt worden.","The sanctity of this place has been fouled."]]},"Besucher":{"t":[["Fische und Besucher stinken nach drei Tagen.","Fish and visitors stink after three days."],["Unsere Besucher kamen zur festgesetzten Zeit an.","Our visitors arrived at the appointed time."],["Wie viele Besucher besuchen jedes Jahr München?","How many visitors visit Munich every year?"],["Die alte Frau betrachtete den Besucher aufmerksam.","The old woman studied the visitor carefully."]],"l":["Weniger Besucher als sonst kommen auf die Henrichshütte - dafür aus wichtigen Gründen.","Wird doch mehr Hilfe benötigt, sollen Besucher dies über ihre Warnblinkanlagen signalisieren.","Zwischen ästhetischen Ansprüchen und Sicherheitsbedenken stehen sich Stadtverwaltung, Schausteller und Besucher gegenüber."]},"besuchen":{"t":[["Weshalb haben Sie das Grab nicht besucht?","Why didn't you come visit the grave?"],["Wie viele Länder hast du schon besucht?","How many countries have you visited?"],["Wie viele Länder haben Sie schon besucht?","How many countries have you visited?"],["Wie viele Länder habt ihr schon besucht?","How many countries have you visited?"]],"l":["Vor allem am Adventswochenende bietet sich ein Besuch auf dem Weihnachtsmarkt an.","Wer auf sein Handy beim Besuch verzichtet, bekommt eine Flasche Wein gratis.","Zentraler Programmpunkt der Fahrt soll ein Besuch des Museums für Bestattungskultur sein."],"b":[["Preußischer Kultusminister konnte man schon unter dem alten Regime sein, ohne selbst jemals eine höhere Unterrichtsanstalt besucht zu haben, während man Vortragender Rat grundsätzlich nur auf Grund der vorgeschriebenen Prüfungen werden konnte.","早在旧政权下，一个人可以当普鲁士文化部长，自己却从未上过高等学校；而要当一名报告参事，原则上必须通过规定的考试。","weber-politik~s-k3-20-1","以政治为业"]]},"Besuchszeit":{"t":[["Die Besuchszeit ist fast vorbei.","Visiting hours are almost over."],["Wie sind die Besuchszeiten?","What are the visiting hours?"],["Wann ist Besuchszeit?","When are visiting hours?"],["Die Besuchszeit ist erst ab 11 Uhr.","Visiting hours don't start until eleven."]],"l":["Außerdem weist die Gesundheitsholding darauf hin, dass die von den Spitälern festgelegten Besuchszeiten eingehalten werden müssen."]}}}