{"e":{"Saphir":[{"p":"noun","g":"m","i":"[ˈzaːfɪʁ]","a":"0/0f/De-Saphir.ogg","s":[["sapphire",[],[]]],"fm":[["Saphir","N s"],["Saphire","N p"],["Saphirs","G s"],["Saphire","G p"],["Saphir","D s"],["Saphiren","D p"],["Saphir","A s"],["Saphire","A p"]],"et":"From Middle High German [Term?].","r":1}],"sapperlot":[{"p":"intj","i":"/zapɐˈloːt/","a":"2/28/De-sapperlot.ogg","s":[["zounds!, swounds!, 'sdeath!, my word!",["dated","regional"],[]],["golly!, zowie!, goodness gracious!, good heavens!, gee whiz!, blast!, doggone!",["dated","regional"],[]]],"et":"Borrowed from French saperlotte (17th century), euphemistic modification of sacredieu, from sacré (nom de) Dieu (literally “holy (name of) God”)."}],"saphirblau":[{"p":"adj","i":"[ˈzaːfɪʁˌblaʊ̯]","a":"2/27/De-saphirblau.ogg","s":[["sapphire (blue in colour)",[],[["rubinrot, smaragdgrün und saphirblau",""]]]],"et":"From Saphir + blau."}],"saphiren":[{"p":"adj","a":"9/99/De-saphiren.ogg","s":[["sapphire",[],[]]],"et":"Saphir + -en"}],"sapphisch":[{"p":"adj","i":"/ˈzapfɪʃ/","a":"2/2c/De-sapphisch.ogg","s":[["Sapphic",[],[]],["sapphic",[],[]]],"et":"Sappho + -isch"}],"Saporoschje":[{"p":"name","a":"a/a3/De-Saporoschje.ogg","s":[["Zaporozhye (a city in Ukraine)",[],[]]],"et":"Borrowed from Russian Запоро́жье (Zaporóžʹje)."}]},"f":{"saphirs":["Saphir"],"saphire":["Saphir"],"saphiren":["Saphir"],"saphirblauer":["saphirblau"],"saphirblaue":["saphirblau"],"saphirblaues":["saphirblau"],"saphirblauen":["saphirblau"],"saphirblauem":["saphirblau"],"saphirener":["saphiren"],"saphirner":["saphiren"],"saphirene":["saphiren"],"saphirne":["saphiren"],"saphirenes":["saphiren"],"saphirnes":["saphiren"],"saphirenen":["saphiren"],"saphirnen":["saphiren"],"saphirenem":["saphiren"],"saphirnem":["saphiren"],"sapphischer":["sapphisch"],"sapphische":["sapphisch"],"sapphisches":["sapphisch"],"sapphischen":["sapphisch"],"sapphischem":["sapphisch"]},"x":{"Saphir":{"l":["Smaragde aus Kolumbien oder Saphire aus Ceylon gelten laut der Expertin als besonders wertvoll.","Das Fabergé-Zigarettenetui zierte ein Verschluss aus Saphir.","Darunter sind blaue und gelbe Saphire, große Smaragde und Brillanten in einzigartiger Qualität, die Claudia Wellendorffs Schwiegervater Hanspeter Wellendorff sammelte."]},"sapperlot":{"l":["Sapperlot, ein Jäger ist er auch noch!"]}}}