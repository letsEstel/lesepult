{"e":{"verquer":[{"p":"adj","a":"f/fe/De-verquer.ogg","s":[["sideways, askew, crooked (positioned out of alignment in a way that is wrong)",[],[]],["strange, odd",[],[]],["strange, odd: nonsensical, absurd (of reasoning, arguments, etc.)",["derogatory","informal"],[]]],"fm":[["verquerer","cp"],["am verquersten","sp"]],"et":"Küpper supposes a univerbation of für (“for”) + quer (“crosswise”), the first part being matched to ver-. Attestations as an adverb reach as far back as the 16th century. Use as an adjective dates at least to the 18th century."}],"verqualmt":[{"p":"adj","i":"/fɛɐ̯ˈkvalmt/","a":"9/93/De-verqualmt.ogg","s":[["smoke-filled",[],[]]],"fm":[["verqualmter","cp"],["am verqualmtesten","sp"]],"r":2}],"verquast":[{"p":"adj","i":"/ˌfɛɐ̯ˈkvaːst/","a":"2/25/De-verquast.ogg","s":[["confused; strange",[],[]]],"fm":[["verquaster","cp"],["am verquastesten","sp"]],"et":"Borrowed from Low German verquars, variant of verdwars, derived from ver- + dwars (“cross, diagonal, aslant”), from Middle Low German dwers, dwer, from Old Saxon thwerh, from Proto-Germanic *þwerhaz. Doublet of synonymous verquer. The final -t in German (or pe…"}],"verquirlen":[{"p":"verb","i":"/fɛɐ̯ˈkvɪʁlən/","a":"9/92/De-verquirlen.ogg","s":[["to whisk",[],[]]],"fm":[["verquirlt","3 pr s"],["verquirlt","pa pc"],["haben","ax"],["verquirlen","if"],["verquirlend","pc pr"],["verquirle","1 pr s"],["verquirlen","1 p pr"],["verquirle","1 k1 s"],["verquirlen","1 k1 p"],["verquirlst","2 pr s"],["verquirlt","2 p pr"],["verquirlest","2 k1 s"],["verquirlet","2 k1 p"],["verquirlen","3 p pr"],["verquirle","3 k1 s"],["verquirlen","3 k1 p"],["verquirlte","1 pa s"],["verquirlten","1 p pa"],["verquirlte","1 formal k2 rare s"],["verquirlten","1 formal k2 p rare"],["verquirltest","2 pa s"],["verquirltet","2 p pa"],["verquirltest","2 formal k2 rare s"],["verquirltet","2 formal k2 p rare"],["verquirlte","3 pa s"],["verquirlten","3 p pa"],["verquirlte","3 formal k2 rare s"],["verquirlten","3 formal k2 p rare"],["verquir