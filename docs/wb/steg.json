ar"],["Steg","genitive masculine singular"]],"stegs":[["Steg","genitive"],["Steg","genitive singular"],["Steg","genitive masculine singular"]],"stege":[["Steg","plural"],["Steg","definite nominative plural"],["Steg","definite genitive plural"],["Steg","dative singular"],["Steg","accusative definite plural"],["Steg","accusative genitive nominative plural"]],"stegen":[["Steg","dative definite plural"],["Steg","dative masculine plural"]],"stegosauriers":[["Stegosaurier","genitive"],["Stegosaurier","genitive singular"]],"stegosauriern":[["Stegosaurier","dative definite plural"],["Stegosaurier","dative masculine plural"]],"stegens":[["Stegen","genitive"]],"stegreifs":[["Stegreif","genitive"],["Stegreif","genitive singular"],["Stegreif","genitive masculine singular"]],"stegreifes":[["Stegreif","genitive"],["Stegreif","genitive singular"]],"stegreife":[["Stegreif","plural"],["Stegreif","definite nominative plural"],["Stegreif","definite genitive plural"],["Stegreif","dative singular"],["Stegreif","accusative definite plural"]],"stegreifen":[["Stegreif","dative definite plural"]],"stegersbachs":[["Stegersbach","genitive"]],"stegreifdichtungen":[["Stegreifdichtung","plural"],["Stegreifdichtung","definite nominative plural"],["Stegreifdichtung","definite genitive plural"],["Stegreifdichtung","dative definite plural"],["Stegreifdichtung","accusative definite plural"]],"stegeinlagen":[["Stegeinlage","plural"],["Stegeinlage","definite nominative plural"],["Stegeinlage","definite genitive plural"],["Stegeinlage","dative definite plural"],["Stegeinlage","accusative definite plural"]],"stegbreiten":[["Stegbreite","plural"],["Stegbreite","definite nominative plural"],["Stegbreite","definite genitive plural"],["Stegbreite","dative definite plural"],["Stegbreite","accusative definite plural"]]},"x":{"Steg":{"t":[["Auf dem Steg fehlen einige Latten.","The jetty has some slats missing."],["Setzen wir uns auf den Steg!","Let's sit on the quay."],["Jemand strich den Steg erneut.","Someone repainted the bridge."],["Als wir anlegten, sahen wir unseren Freund auf dem Steg.","When we landed, we saw our friend on the pier."]],"l":["Bei Barça seien unterdessen „alle super enttäuscht“, sagte ter Stegen ein.","Durch das Schwanken des Schiffs drohte der Steg zeitweise zu brechen.","Nationaltorwart Marc-André ter Stegen fällt wohl über ein halbes Jahr aus."],"b":[["„Wir können nicht hinüber,“ sprach Hänsel, „ich sehe keinen Steg und keine Brücke.“","「我们过不去，」亨塞尔说，「我看不见小桥，也看不见大桥。」","grimm~s-k015-8-7","格林童话（读本）"],["Da rief sie „Entchen, Entchen, da steht Grethel und Hänsel. Kein Steg und keine Brücke, nimm uns auf deinen weißen Rücken.“","她就喊道：「小鸭子，小鸭子，格蕾特和亨塞尔站在这儿。没有小桥也没有大桥，把我们驮到你白白的背上吧。」","grimm~s-k015-8-9","格林童话（读本）"]]},"Stegen":{"l":["Bei Barça seien unterdessen „alle super enttäuscht“, sagte ter Stegen ein.","Nationaltorwart Marc-André ter Stegen fällt wohl über ein halbes Jahr aus.","Ter Stegen pariert den Abschluss des Franzosen und auch den folgenden Nachschuss von Asensio."]},"Stegreif":{"t":[["Hast du die Rede aus dem Stegreif gehalten?","Did you make your speech off-the-cuff?"],["Er hielt eine kleine Ansprache aus dem Stegreif, ohne jede Vorbereitung, und er gewann die Herzen seiner Zuhörer.","He gave a short speech, completely off the cuff, and won the hearts of his listeners."]],"l":["Die Frage, wie man die Mehrkosten alternativ finanziere, bekomme man aber aus dem Stegreif nicht gelöst, meint Fraktionsvorsitzender Christian Gött."]}}}