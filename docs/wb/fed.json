,"dative definite plural"]],"federkernes":[["Federkern","genitive"],["Federkern","genitive singular"]],"federkerns":[["Federkern","genitive"],["Federkern","genitive singular"]],"federkerne":[["Federkern","plural"],["Federkern","definite nominative plural"],["Federkern","definite genitive plural"],["Federkern","dative singular"],["Federkern","accusative definite plural"],["Federkern","accusative genitive nominative plural"]],"federkernen":[["Federkern","dative definite plural"]],"federpennals":[["Federpennal","genitive"],["Federpennal","genitive singular"]],"federpennale":[["Federpennal","plural"],["Federpennal","definite nominative plural"],["Federpennal","definite genitive plural"],["Federpennal","accusative definite plural"]],"federpennalen":[["Federpennal","dative definite plural"]],"federgewichtes":[["Federgewicht","genitive"],["Federgewicht","genitive singular"]],"federgewichts":[["Federgewicht","genitive"],["Federgewicht","genitive singular"]],"federgewichte":[["Federgewicht","plural"],["Federgewicht","definite nominative plural"],["Federgewicht","definite genitive plural"],["Federgewicht","dative singular"],["Federgewicht","accusative definite plural"],["Federgewicht","accusative genitive nominative plural"]],"federgewichten":[["Federgewicht","dative definite plural"],["Federgewicht","dative plural"]],"federgewichtlers":[["Federgewichtler","genitive"],["Federgewichtler","genitive singular"]],"federgewichtlerin":[["Federgewichtler","feminine"]],"federgewichtlern":[["Federgewichtler","dative definite plural"],["Federgewichtler","dative plural"]],"federwolken":[["Federwolke","feminine plural"],["Federwolke","plural"],["Federwolke","definite nominative plural"],["Federwolke","definite genitive plural"],["Federwolke","dative definite plural"],["Federwolke","accusative definite plural"]],"federballschlägers":[["Federballschläger","genitive"],["Federballschläger","genitive singular"]],"federballschlägern":[["Federballschläger","dative definite plural"],["Federballschläger","dative plural"]]},"x":{"Feder":{"t":[["Die Sonne lacht – raus aus den Federn!","The sun's out – rise and shine!"],["Die Feder ist die Sprache der Seele.","The pen is the language of the soul."],["Die Federn dieses Papageien sind so bunt!","The feathers of this parrot are so colourful!"],["Schauen Sie sich mal diese Federn an.","Take a look at these feathers."]],"l":["Dann wird es womöglich einen Nachfolger oder eine Nachfolgerin mit Federn geben.","In einem kleinen verglasten Kammerl sitzt eine Dame, welche die Federn \"testschreibt\".","Mithilfe der Bürzeldrüse ölen sie ihre Federn und machen diese dadurch wasserabweisend."],"b":[["Sie machte auch der Frau Holle das Bett nicht wie sichs gebührte, und schüttelte es nicht, daß die Federn aufflogen.","她也不好好给霍勒太太铺床，不抖被子，羽毛也不飞起来。","grimm~s-k024-5-1","格林童话（读本）"],["Du mußt nur Acht geben daß du mein Bett gut machst und es fleißig aufschüttelst, daß die Federn fliegen, dann schneit es in der Welt; ich bin die Frau Holle.“","你只要留心把我的床铺好，用力抖被子，抖得羽毛乱飞，人间就下雪了。我是霍勒太太。」","grimm~s-k024-2-2","格林童话（读本）"],["Es besorgte auch alles nach ihrer Zufriedenheit, und schüttelte ihr das Bett immer gewaltig auf daß die Federn wie Schneeflocken umher flogen; dafür hatte es auch ein gut Leben bei ihr, kein böses Wort, und alle Tage Gesottenes und Gebratenes.","她把一切都办得让老婆婆满意，每次都使劲抖被子，抖得羽毛像雪花一样四处飞舞；为此她在那里过得也很好，没听过一句重话，天天有炖的有烤的。","grimm~s-k024-2-4","格林童话（读本）"]]},"federführend":{"t":[["Bei der Abfassung der Resolution war Tom federführend.","Tom was in charge of drawing up the resolution."]],"l":["Federführend ist Herbert Moser, der früher schon als Ministrant mitgeholfen hat.","Geschrieben wurde diese von Scott Westerfeld, der ebenfalls bei den Fortsetzungen federführend war.","Islam hat der beim Übergang federführenden Armee Friedensnobelpreisträger Muhammad Yunus als Interimspremier vorgeschlagen."]},"Federball":{"t":[["Hey, Fred, wie wär’s mit Federball am Donnerstag?","Hi, Fred, how about badminton on Thursday?"],["Sie spielen hier oft Federball.","They play badminton here often."],["Tom sagte, er habe Maria mit Johannes Federball spielen sehen.","Tom said that he saw Mary playing badminton with John."]]},"federleicht":{"t":[["Du bist federleicht, mein Schatz.","You are light as a feather, my darling."],["Ich fühlte mich federleicht.","I felt light as a feather."]],"l":["Wer gerade nicht so viel Glück hat, braucht vielleicht einen besonderen Duft, der nach dem Aufsprühen ein gutes und federleichtes Gefühl hinterlässt."]},"Federspitze":{"l":["Von 1970 bis 1974 schärfte er dort seine Federspitze, bevor er sich in die Welt der Lokalredaktion stürzte."]},"Federhalter":{"t":[["„Von wem sind diese Federhalter?“ — „Sie sind von Tom.“","\"Whose pens are these?\" \"They are Tom's.\""]]},"Federbett":{"t":[["Im Winter decke ich mich mit einem Federbett zu.","In winter I tuck myself up in a duvet."]]},"Federmappe":{"t":[["Jetzt ist das Federmäppchen unter dem Tisch.","The pencil case is now under the table."],["Tom steckt seine Stifte in seine Federmappe.","Tom is putting his pens into the pencil case."],["Ich habe meine Federmappe zu Hause liegenlassen.","I forgot my pencil case at home."],["Er nahm einen Buntstift aus seinem Federmäppchen.","He took a colored pencil out of his pencil case."]],"l":["In Kooperation mit sozialen Einrichtungen in Gelsenkirchen sollen daraus Taschen, Federmäppchen und Co. hergestellt werden.","Neugierig schauten wir uns das Schulhaus in Le Landeron an, waren stolz, das Wörtli «trousse» fürs Federmäppchen zu beherrschen."]},"Federlesen":{"t":[["Er macht kein Federlesens darum, es zuzugeben.","He makes no bones about admitting it."]],"l":["Beim 4:1 im Topspiel als Gast der SG Bingerbrück/Weiler machte der Primus mit dem Gegner nicht viel Federlesens."],"b":[["Aber der Wolf fand sie alle und machte nicht langes Federlesen: eins nach dem andern schluckte er in seinen Rachen; nur das jüngste in dem Uhrkasten das fand er nicht.","可是狼把它们都找到了，毫不客气：一只接一只吞进了它的大嘴；只有最小的那只躲在钟箱里，狼没有找到。","grimm~s-k005-2-6","格林童话（读本）"]]},"Federung":{"t":[["Ein Renault 6 benutzt keine Spiralfedern oder Blattfedern. Er hat Drehstäbe in der Federung.","A Renault 6 doesn't use coil springs or leaf springs. It uses torsion bars in the suspension."]],"l":["Es bietet zudem eine gute Lichtanlage, Schutzbleche, Gepäckträger, Federung vorn und hinten sowie ordentliche Bremsen.","Das Gefühl der Lenkung, das Ansprechverhalten der Dämpfer und Federung, die Abstimmung des Acht-Gang-Automatikgetriebes – alles eine Klasse für sich."]}}}