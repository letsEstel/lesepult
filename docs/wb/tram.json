mpelpfade":[["Trampelpfad","plural"],["Trampelpfad","definite nominative plural"],["Trampelpfad","definite genitive plural"],["Trampelpfad","dative singular"],["Trampelpfad","accusative definite plural"],["Trampelpfad","accusative genitive nominative plural"]],"trampelpfaden":[["Trampelpfad","dative definite plural"],["Trampelpfad","dative masculine plural"]],"trampeln":[["trampeln","gerund neuter no-plural strong"],["Trampel","dative masculine plural"]],"trampen":[["trampen","gerund neuter no-plural strong"]],"trambahnen":[["Trambahn","plural"],["Trambahn","definite nominative plural"],["Trambahn","definite genitive plural"],["Trambahn","dative definite plural"],["Trambahn","accusative definite plural"]],"trampolinturnens":[["Trampolinturnen","genitive"],["Trampolinturnen","genitive singular"]],"trampolinturners":[["Trampolinturner","genitive"],["Trampolinturner","genitive singular"]],"trampolinturnerin":[["Trampolinturner","feminine"]],"trampolinturnern":[["Trampolinturner","dative definite plural"]]},"x":{"Tram":{"t":[["Die Stadt hat sich entschieden, die Tram abzuschaffen.","The city has decided to do away with the streetcar."],["Die Tramen, die auf den Pfeilern liegen, halten das Gewicht und verteilen es.","The beams, held up by the columns, support and distribute the weight."]],"l":["An der Haltestelle Prenzlauer Allee/Kanzowstraße sollen beide Männer die Tram verlassen haben.","Blick auf die Unfallstelle in München, wo eine Tram mit einem Linienbus kollidierte.","Immer mehr Menschen steigen am Messeplatz aus dem Tram und peilen die Attraktionen an."]},"Trampolin":{"t":[["Tom und Maria sprangen auf dem Trampolin.","Tom and Mary jumped on the trampoline."],["Die Kinder hüpften auf dem Trampolin.","The kids jumped on the trampoline."],["Die Kinder hüpfen auf dem Trampolin.","The children are bouncing on the trampoline."],["Im Garten steht ein Trampolin.","There's a trampoline in the backyard."]],"l":["Kommt sie nicht über ein Hindernis, hilft vielleicht eine Kiste oder ein Trampolin.","Nach der Steinschleuder benutzt ihr das Trampolin zu eurer Linken.","Auch die Firma Kaltschütz ist zur Freude der Kinder dabei, Anlagen wie Trampolin, Wasserspiele usw. aufzubauen."]},"trampeln":{"t":[["Sie trampelte den Schlamm von ihren Schuhen.","She stamped the mud off her shoes."],["Tom trampelte dahin wie ein Elefant.","Tom lumbered along like an elephant."],["Tom baute eine Sandburg; Maria trampelte sie dann nieder.","Tom built a sandcastle. Mary then trampled it."],["Die Kinder trampelten auf dem Rasen herum, und der Wachmann schimpfte sie aus.","The children trampled on the grass and the guard scolded them."]],"l":["Zwischen Wolkenkratzern, Menschenmassen und Verkehrschaos trampelt neuerdings eine Elefantenherde durch New York - für Selfies und für den guten Zweck."]},"Trampel":{"t":[["„Ich habe eine Farbdose umgeworfen.“ – „Du Trampel!“","\"I knocked over a tin of paint.\" \"You plonker!\""]]},"trampen":{"t":[["Ich mag das Trampen nicht.","I don't like hitchhiking."],["Ist Trampen in Australien verboten?","Is hitchhiking prohibited in Australia?"],["Tom sagte, dass er Lust hätte, seinen Job zu schmeißen und rund um Australien zu trampen.","Tom said he had half a mind to throw in his job and hitchhike around Australia."],["Tom sagte, er hätte nicht übel Lust, seinen Job hinzuschmeißen und quer durch Australien zu trampen.","Tom said he had half a mind to throw in his job and hitchhike around Australia."]],"l":["Trampend macht sie sich nach Hamburg auf, wo sie binnen kurzer Zeit eine Bühne für ihre vielfältigen Erfahrungen findet."]},"Trampeltier":{"t":[["Trampeltiere haben zwei Höcker auf dem Rücken.","Bactrian camels have two humps on their back."],["Du Trampeltier hast schon wieder alles umgeworfen.","You klutz tore it all down again."],["Ein Dromedar hat einen Höcker, aber ein Trampeltier hat zwei Höcker.","A dromedary has one hump, but a bactrian camel has two humps."],["Trampeltiere können bis zu 57 Liter Wasser auf einmal trinken.","Bactrian camels can drink up to 57 liters of water at once."]],"l":["Die Trampeltiere sind die Nachfahren jener Last- und Nutztiere, die Seidenstraßen-Händler im Nubra-Tal zurückgelassen haben."]},"Trambahn":{"t":[["Die Stadt hat sich entschieden, die Trambahn abzuschaffen.","The city has decided to do away with the streetcar."]]},"Trampolinturner":{"l":["Eine Kombination aus zehn Sprüngen zeigen die Trampolinturner bei einem Wettkampf.","Sie könnte die einzige Medaille für Russland holen: Trampolinturnerin Angela Bladzewa."]}}}