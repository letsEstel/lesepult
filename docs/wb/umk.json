sses":["Umkehrschluss"],"umkehrschlüsse":["Umkehrschluss"],"umkehrschlusse":["Umkehrschluss"],"umkehrschlüssen":["Umkehrschluss"],"umkämpfend":["umkämpfen"],"umkämpfe":["umkämpfen"],"umkämpfst":["umkämpfen"],"umkämpfest":["umkämpfen"],"umkämpfet":["umkämpfen"],"umkämpftest":["umkämpfen"],"umkämpftet":["umkämpfen"],"umkämpf":["umkämpfen"],"umkleidend":["umkleiden"],"umkleide":["umkleiden"],"umkleidest":["umkleiden"],"umkleidet":["umkleiden"],"umkleidete":["umkleiden"],"umkleideten":["umkleiden"],"umkleidetest":["umkleiden"],"umkleidetet":["umkleiden"],"umkucken":["umgucken"]},"x":{"Umkreis":{"t":[["Heute umkreisen unsere künstlichen Satelliten die Erde.","Today our artificial satellites are revolving around the earth."],["Hier im Umkreis gibt es viele moderne Gebäude.","There are many modern buildings around here."],["Bitte umkreisen Sie die richtige Antwort.","Please circle the right answer."],["Wie viele Planeten umkreisen die Sonne?","How many planets orbit the sun?"]],"l":["Die US-Sonde wird nicht landen, den Mond noch nicht einmal umkreisen.","Er verweist darauf, dass es im Umkreis weitere Lagerhäuser gibt.","Über weitere Teilnehmer aus dem Umkreis würde sie sich freuen, verriet sie bei „Radio Travemünde“."]},"umkämpft":{"l":["Lichtblick im schwierigen GPU-Markt Intel verbucht einen Erfolg im hart umkämpften Grafikkartenmarkt.","Russische Truppen nähern sich nun auch von Süden der umkämpften Stadt Pokrowsk.","Von den umkämpften Städten und Gebieten sind inzwischen oft nur Ruinen übrig."]},"umkrempeln":{"l":["Um seinen Lebensstil umzukrempeln, braucht es oft nicht viel.","Und eben diese Williams-Kultur, die über die Jahre wiederholt kritisiert wurde, werde jetzt schrittweise umgekrempelt.","Borussia Dortmund wird den Kader im Sommer umkrempeln."]},"umkommen":{"t":[["Sie sind einer nach dem anderen umgekommen.","They died one after another."],["Bei dem Autounfall sind wenige Personen umgekommen.","Few people were killed in the car accident."],["Tom war der einzige, der nicht umkam.","Tom was the only one who wasn't killed."],["Sie haben Glück, daß Sie nicht umgekommen sind.","You're lucky that you weren't killed."]],"l":["Sie ist froh, dass der Klebeprotest vorbei und niemand dabei \"umgekommen\" ist.","Meine Großmutter ist umgekommen, weil sie nicht in den Luftschutzkeller wollte.","Der Andrang war riesig, es kam zu panikartigen Szenen, über hundert Menschen sollen dabei umgekommen sein."]},"umkehren":{"t":[["Es ist nie zu spät, um umzukehren.","It's never too late to turn back."],["Es ist nicht zu spät, um umzukehren.","It's not too late to turn back."],["Die Frau ist dem Mann gleichgestellt und umgekehrt.","Women are equal to men and vice versa."],["Hat Tom mit Maria Schluss gemacht oder umgekehrt?","Was Tom dumped by Mary, or was she dumped by him?"]],"l":["Scholz tut es nun umgekehrt: Er reist zuerst nach Chongqing und Shanghai.","Wie schlägt sich der Umfragekönig Pistorius im Vergleich zum Kanzler und umgekehrt?","Umgekehrt sind es gerade die hehren Grundsätze, die Genossenschaften anfällig machen."],"b":[["Man wird in dem vorhergehenden Beweise gewahr, daß das Spiel, welches der Idealismus trieb, ihm mit mehrerem Rechte umgekehrt vergolten wird.","从上面的证明中可以发觉：唯心论所玩的那套游戏，被更有理由地反过来回敬给了它自己。","kant-krv~s-w-4-0","纯粹理性批判（选读）"],["Etwas anderes aber und ganz Widersinnisches tritt an die Stelle dieser vergeblich gesuchten Deduktion des moralischen Prinzips, nämlich daß es umgekehrt selbst zum Prinzip der Deduktion eines unerforschlichen Vermögens dient, welches keine Erfahrung beweisen, die spekulative Vernunft aber (um unter ihren kosmologischen Ideen das Unbedingte seiner Kausalität nach zu finden, damit sie sich selbst nicht widerspreche) wenigstens als möglich annehmen mußte, nämlich das der Freiheit, von der das moralische Gesetz, welches selbst keiner rechtfertigenden Gründe bedarf, nicht bloß die Möglichkeit, sondern die Wirklichkeit an Wesen beweist, die dies Gesetz als für sie verbindend erkennen.","取代这个徒劳寻求的道德原则演绎的，是另一种完全出人意料的东西：道德原则反过来自己充当了一种无法探究的能力的演绎原则。这种能力，没有任何经验能证明它，但思辨理性（为了在它的宇宙论理念中按因果性找到无条件者，以免自相矛盾）至少不得不假定它是可能的；这就是自由的能力。不需要任何辩护理由的道德法则，在那些认识到这条法则对自己有约束力的存在者身上，不仅证明了自由的可能性，而且证明了它的现实性。","kant-kpv~s-f-3-1","实践理性批判（选读）"],["Damit ist freilich nicht auch das Umgekehrte gesagt: daß eine solche plutokratische Leitung auch zugleich bedeutete, daß die politisch herrschende Schicht nicht auch »von« der Politik zu leben trachtete, also ihre politische Herrschaft nicht auch für ihre privaten ökonomischen Interessen auszunutzen pflegte.","当然，这并不是说反过来也成立：好像这样的财阀式领导同时就意味着，政治统治阶层不会也谋求「靠」政治而活，也就是不会惯于把自己的政治统治也用于自己私人的经济利益。","weber-politik~s-k3-8-1","以政治为业"]]},"Umkleidekabine":{"t":[["Ich habe meinen Bademantel in der Umkleidekabine vergessen.","I've left my dressing gown in the cubicle."],["Die Umkleidekabine der Mädchen ist sauber.","The locker room of the girls is clean."],["Dann ging ich die Treppe hoch zu den Umkleidekabinen.","Then I walked upstairs to the dressing rooms."],["Wo sind die Umkleidekabinen?","Where are the changing rooms?"]],"l":["\"Wenn man so etwas plant, muss man doch an eine Umkleidekabine denken.","Die Umkleidekabinen des SV Bad Rothenfelde.","Nach Lehners Ansprache folgt gemäss Programm um 10.30 Uhr eine Begehung, eine Fotoausstellung in den Umkleidekabinen und ein Stehapéro."]},"Umkehrung":{"l":["Auf dem Höhepunkt des Zyklus kommt es zu einer Umkehrung der magnetischen Pole der Sonne.","Es handelt sich um eine katastrophale Umkehrung des Täter-Opfer-Prinzips."]},"umkippen":{"t":[["Tom sah aus, als wäre er kurz vorm Umkippen.","Tom looked like he was going to pass out."],["Ich könnte vor Hunger umkippen.","I'm so hungry I could faint."],["Der Zug war umgekippt.","The train was overturned."],["Der Lastwagen kann umkippen.","The lorry might tip over."]],"l":["Es war der Lenker des Pkw, der umgekippt auf dem Beifahrersitz lag.","Er hat den ersten Stein angetippt – nach und nach sind immer weitere umgekippt.","Jetzt hat er Angst vor weiteren Bäumen, die umkippen könnten."]},"umklappen":{"t":[["Der Wind war so stark, dass er Marias Schirm umklappte.","The wind was so strong it blew Mary's umbrella inside out."]],"l":["Gänzlich umklappen lässt sich das Display aber nicht.","Die Rücksitzlehnen lassen sich nur im Verhältnis 40:60 umklappen, also nicht in drei Teilen wie bei BMW.","Wer viel zu transportieren hat, kann das Fondgestühl umklappen, um bis zu 15 Zentimeter nach vorne schieben oder ganz ausbauen."]},"umkreisen":{"t":[["Der Satellit hat die Erde zehnmal umkreist.","The satellite made 10 orbits of the earth."],["Heute umkreisen unsere künstlichen Satelliten die Erde.","Today our artificial satellites are revolving around the earth."],["Bitte umkreisen Sie die richtige Antwort.","Please circle the right answer."],["Wie viele Planeten umkreisen die Sonne?","How many planets orbit the sun?"]],"l":["Die US-Sonde wird nicht landen, den Mond noch nicht einmal umkreisen.","Er verweist darauf, dass es im Umkreis weitere Lagerhäuser gibt.","Über weitere Teilnehmer aus dem Umkreis würde sie sich freuen, verriet sie bei „Radio Travemünde“."]},"umklammern":{"t":[["Er umklammerte den Ast.","He held on firmly to the branch."],["Sie umklammert ihre Wärmflasche.","She is clutching her hot-water bottle."]],"l":["In der Hand fest umklammert sein Trikot.","Eine Leibwächterin umklammert Donald Trump, der von drei Secret-Service-Leuten geschützt wird, während er kämpferisch die Faust gen Himmel reckt.","Hier soll der Mann die 19-Jährige laut Angaben der Polizei unvermittelt umklammert und sexuell bedrängt haben."]},"Umkehr":{"t":[["Auch Umkehr kann Fortschritt sein.","A return can also be progress."],["Eine Umkehr ist ausgeschlossen.","There is no going back."]],"l":["Ein UN-Bericht zeigt, wie ernst es den Ländern damit ist, die Umkehr einzuleiten.","Jetzt fordert eine Umkehr in der Taurus-Debatte und fällt Scholz in den Rücken.","Sollte die AfD aber Teil einer Regierung werden, rechnet Shahid mit einer Umkehr ins Negative."]},"Umkehrschluss":{"l":["Im Umkehrschluss würden sie dann aber diejenigen „hassen“, die Familie und ein Zuhause hätten.","Versuchen wir den Umkehrschluss: Wenn also jemand bewusst nicht gendert – ist das dann völlig neutral und hat nicht im Geringsten mit einer Überzeugung tun?","Bei zehn der 13 Turnieren konnte der Deutsche Preisgeld einspielen, heißt im Umkehrschluss, dass er sein Auftaktmatch nur drei Mal verlor – eine beeindruckende Konstanz."]},"umkämpfen":{"l":["Lichtblick im schwierigen GPU-Markt Intel verbucht einen Erfolg im hart umkämpften Grafikkartenmarkt.","Russische Truppen nähern sich nun auch von Süden der umkämpften Stadt Pokrowsk.","Von den umkämpften Städten und Gebieten sind inzwischen oft nur Ruinen übrig."]},"umkleiden":{"t":[["Tom sah sich in der Umkleide um.","Tom looked around the locker room."],["Die Umkleide befindet sich dort drüben.","The dressing room is over there."],["Entschuldigung, wo ist die Umkleide?","Excuse me, where is the dressing room?"],["Die Spieler haben sich über die schmützigen Umkleiden beschwert.","The players complained about the dirty locker rooms."]],"l":["Später musste Collins mit einer großen Strafe vorzeitig in die Umkleide.","Er weiß also, wie wichtig es ist, dass in der Umkleide alles am richtigen Ort liegt.","Wo finde ich Duschen und Umkleiden im Zielbereich?"]}}}