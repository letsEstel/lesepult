 subjunctive subjunctive-ii subordinate-clause"],["unterordneten","first-person formal plural rare subjunctive subjunctive-ii subordinate-clause"],["unterordnetest","indicative preterite second-person singular subordinate-clause"],["unterordnetet","indicative plural preterite second-person subordinate-clause"],["unterordnetest","formal rare second-person singular subjunctive subjunctive-ii subordinate-clause"],["unterordnetet","formal plural rare second-person subjunctive subjunctive-ii subordinate-clause"],["unterordnete","indicative preterite singular subordinate-clause third-person"],["unterordneten","indicative plural preterite subordinate-clause third-person"],["unterordnete","formal rare singular subjunctive subjunctive-ii subordinate-clause third-person"],["unterordneten","formal plural rare subjunctive subjunctive-ii subordinate-clause third-person"]],"et":"From unter- + ordnen.","r":2}]},"f":{"unteroffiziers":[["Unteroffizier","genitive"],["Unteroffizier","genitive singular"],["Unteroffizier","genitive masculine"]],"unteroffiziere":[["Unteroffizier","plural"],["Unteroffizier","definite nominative plural"],["Unteroffizier","definite genitive plural"],["Unteroffizier","accusative definite plural"],["Unteroffizier","accusative genitive masculine nominative plural"]],"unteroffizierin":[["Unteroffizier","feminine"]],"unteroffizieren":[["Unteroffizier","dative definite plural"],["Unteroffizier","dative masculine plural"]],"unterordnungen":[["Unterordnung","plural"],["Unterordnung","definite nominative plural"],["Unterordnung","definite genitive plural"],["Unterordnung","dative definite plural"],["Unterordnung","accusative definite plural"]],"unterordners":[["Unterordner","genitive"],["Unterordner","genitive singular"],["Unterordner","genitive masculine"]],"unterordnern":[["Unterordner","dative definite plural"],["Unterordner","dative masculine plural"]],"unterordnend":[["unterordnen","participle present"]],"unterordne":[["unterordnen","first-person indicative present singular subordinate-clause"],["unterordnen","first-person singular subjunctive subjunctive-i subordinate-clause"],["unterordnen","singular subjunctive subjunctive-i subordinate-clause third-person"]],"unterordnest":[["unterordnen","indicative present second-person singular subordinate-clause"],["unterordnen","second-person singular subjunctive subjunctive-i subordinate-clause"]],"unterordnet":[["unterordnen","indicative plural present second-person subordinate-clause"],["unterordnen","plural second-person subjunctive subjunctive-i subordinate-clause"],["unterordnen","indicative present singular subordinate-clause third-person"]],"unterordnete":[["unterordnen","first-person indicative preterite singular subordinate-clause"],["unterordnen","first-person formal rare singular subjunctive subjunctive-ii subordinate-clause"],["unterordnen","indicative preterite singular subordinate-clause third-person"],["unterordnen","formal rare singular subjunctive subjunctive-ii subordinate-clause third-person"]],"unterordneten":[["unterordnen","first-person indicative plural preterite subordinate-clause"],["unterordnen","first-person formal plural rare subjunctive subjunctive-ii subordinate-clause"],["unterordnen","indicative plural preterite subordinate-clause third-person"],["unterordnen","formal plural rare subjunctive subjunctive-ii subordinate-clause third-person"]],"unterordnetest":[["unterordnen","indicative preterite second-person singular subordinate-clause"],["unterordnen","formal rare second-person singular subjunctive subjunctive-ii subordinate-clause"]],"unterordnetet":[["unterordnen","indicative plural preterite second-person subordinate-clause"],["unterordnen","formal plural rare second-person subjunctive subjunctive-ii subordinate-clause"]],"unterordnen":[["unterordnen","gerund neuter no-plural strong"]]},"x":{"Unteroffizier":{"t":[["Die kleinsten Unteroffiziere sind die stolzesten.","The lowest N.C.O.'s are the proudest."]],"l":["Walz wurde 2006 gewählt, Anfang 2007 zog er ins Repräsentantenhaus ein - als ranghöchster Unteroffizier.","Zehn neue Unteroffiziere und sechs neue Offiziere des Bundesheeres wurden vor dem Landhaus in Eisenstadt offiziell vorgestellt.","So weise die Miliz bereits jetzt ein jährliches Fehl an 120 Offizieren und 560 Unteroffizieren auf."]},"Unterordnung":{"t":[["Wir haben die Alternativen des Todes und der Unterordnung.","We have the alternative of death and submission."]]},"unterordnen":{"t":[["Alle anderen Fragen sind dieser untergeordnet.","All the other issues are subordinate to this one."],["In den letzten sieben Jahren habe ich mein Leben diesem Kampf untergeordnet.","For the last seven years, I've given this fight precedence over my own life."]],"l":["Denn alles hier ist einem „Storytelling“ untergeordnet, und dieses lautet: Südamerika.","Männer haben gelernt, dass Gewalt ein probates Mittel ist, um sich durchzusetzen, Frauen lernen sich unterzuordnen.","Wir zehn anderen haben uns ihm völlig untergeordnet."],"b":[["Diese logische Maxime kann aber nicht anders ein Prinzipium der reinen Vernunft werden, als dadurch, daß man annimmt: wenn das Bedingte gegeben ist, so sei auch die ganze Reihe einander untergeordneter Bedingungen, die mithin selbst unbedingt ist, gegeben, (d.i. in dem Gegenstande und seiner Verknüpfung enthalten).","但这条逻辑准则要成为纯粹理性的原理，只有这样：人们假定，如果有条件者被给予了，那么彼此隶属的条件的整个序列（它本身因而是无条件的）也被给予了，即包含在对象及其联结之中。","kant-krv~s-d-1-1","纯粹理性批判（选读）"],["Wenn nun Dinge der Welt, als ihrer Existenz nach abhängige Wesen, einer nach Zwecken handelnden obersten Ursache bedürfen, so ist der Mensch der Schöpfung Endzweck; denn ohne diesen wäre die Kette der einander untergeordneten Zwecke nicht vollständig gegründet; und nur im Menschen, aber auch in diesem nur als Subjekte der Moralität ist die unbedingte Gesetzgebung in Ansehung der Zwecke anzutreffen, welche ihn also allein fähig macht, ein Endzweck zu sein, dem die ganze Natur teleologisch untergeordnet ist.","如果世上的事物作为在存在上有所依赖的存在者，需要一个按照目的行动的至上原因，那么人就是创造的终极目的；因为没有人，彼此从属的目的之链就不会有完整的根据；而只有在人身上，并且也只有在作为道德主体的人身上，才能找到关于目的的无条件的立法；只有这种立法，才使人能够成为一个终极目的，整个自然都在目的论上从属于它。","kant-kdu~s-t-7-2","判断力批判（选读）"]]}}}