]],"ziffernblatte":[["Ziffernblatt","dative singular"]],"ziffernblättern":[["Ziffernblatt","dative definite plural"]],"ziffernsturzes":[["Ziffernsturz","genitive"],["Ziffernsturz","genitive singular"]],"ziffernstürze":[["Ziffernsturz","plural"],["Ziffernsturz","definite nominative plural"],["Ziffernsturz","definite genitive plural"],["Ziffernsturz","accusative definite plural"]],"ziffernsturze":[["Ziffernsturz","dative singular"]],"ziffernstürzen":[["Ziffernsturz","dative definite plural"]]},"x":{"Ziffer":{"t":[["Die Postleitzahlen in Spanien haben fünf Ziffern.","Postcodes in Spain have five digits."],["Die spanischen Postleitzahlen bestehen aus fünf Ziffern.","Spanish postcodes have five digits."],["Wie viele Stellen hat die Ziffer?","How many digits does that number have?"],["Eine Zahl ist eine Menge, die mit Ziffern geschrieben wird.","A number is a quantity written in digits."]],"l":["Alle Ziffern sind gerundet, um die relative Genauigkeit der Schätzung widerzugeben.","Zürcher Kontrollschilder dürften bald um eine Ziffer länger werden: Abendverkehr in der Stadt Zürich.","Falls Sie nicht sicher sind, welche Ziffer für Sie relevant ist, werfen Sie einen Blick auf Ihre Kindergeldnummer."]},"Zifferblatt":{"l":["Hinter dem Zifferblatt steckt ein bekannter Prozessor, die Konnektivität hat Google jedoch aufgewertet.","Blickfang ist das Zifferblatt, inspiriert vom Eis des Mer de Glace, dem Hauptgletscher des Mont-Blanc-Massivs.","So ist zum Beispiel das Zifferblatt der Stahl-Platin-Uhr (40 Millimeter) ganz fein von Hand guillochiert."]}}}