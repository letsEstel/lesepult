lural"],["Birkenast","plural"],["Birkenast","definite nominative plural"],["Birkenast","definite genitive plural"],["Birkenast","accusative definite plural"]],"birkenastes":[["Birkenast","genitive masculine singular"],["Birkenast","genitive"],["Birkenast","genitive singular"]],"birkenasts":[["Birkenast","genitive masculine singular"],["Birkenast","genitive"],["Birkenast","genitive singular"]],"birkenaste":[["Birkenast","dative singular"]],"birkenästen":[["Birkenast","dative definite plural"]],"birkenpilzes":[["Birkenpilz","genitive"],["Birkenpilz","genitive singular"]],"birkenpilze":[["Birkenpilz","plural"],["Birkenpilz","definite nominative plural"],["Birkenpilz","definite genitive plural"],["Birkenpilz","dative singular"],["Birkenpilz","accusative definite plural"]],"birkenpilzen":[["Birkenpilz","dative definite plural"]],"birkenröhrlings":[["Birkenröhrling","genitive"],["Birkenröhrling","genitive singular"]],"birkenröhrlinge":[["Birkenröhrling","plural"],["Birkenröhrling","definite nominative plural"],["Birkenröhrling","definite genitive plural"],["Birkenröhrling","accusative definite plural"]],"birkenröhrlingen":[["Birkenröhrling","dative definite plural"]]},"x":{"Birne":{"t":[["Die ersten Birnen fielen schon vom Baum.","The first pears were already falling from the tree."],["Diese Birne ist besser als deine.","This pear is better than yours."],["Das ist eine Birne, kein Apfel.","This is a pear, not an apple."],["Auf diesem Stand gibt es die billigsten Birnen.","There are the cheapest pears at this stand."]],"l":["Eine Sportart, die den ganzen Körper anspricht, die Koordination und die Birne.","Früchte wie Äpfel, Birnen, Aprikosen, Bananen, Kirschen und Ananas werden oft gut vertragen.","Und: Äpfel und Birnen sind in der Zellteilungsphase – sie lieben es in dieser Zeit nass."]},"Birmingham":{"t":[["Entschuldigung, geht dieser Bus nach Birmingham?","Excuse me, does this bus go to Birmingham?"],["Warst du schon einmal in Birmingham?","Have you been to Birmingham?"],["Wart ihr schon einmal in Birmingham?","Have you been to Birmingham?"],["Waren Sie schon einmal in Birmingham?","Have you been to Birmingham?"]],"l":["Während eines Freundschaftsspiels in Birmingham entdeckte Adam Price einen ungewöhnlichen blauen Fleck.","Die fehlt Birmingham wegen muskulärer Probleme bereits seit zehn Spieltagen.","Beim Tory-Parteitag in Birmingham kommt es zum grossen Schaulaufen von vier Kandidaten um den Parteivorsitz."]},"Birke":{"t":[["Neben dem Haus wächst eine schöne Birke.","Next to the house, a beautiful birch tree is growing."],["Neben dem Haus steht eine schöne Birke.","Next to the house, there's a beautiful birch tree."],["In diesem Wald wachsen Eichen, Kiefern und Birken.","Oaks, pines and birches grow in these woods."],["Die Rinde der Birke ist weiß.","The birch's bark is white."]],"l":["Die Stadt hat im Wald am Schulbiologiezentrum Hannover Erlen und Birken fällen lassen.","Stadtgrün sei wichtig, allerdings solle man bei Neupflanzungen lieber auf Pollenschleudern wie Birken verzichten.","Die Birke wurde von den Einsatzkräften mittels Motokettensäge zerkleinert und beseitigt und der Telefonanbieter wurde aufgrund der beschädigten Leitung informiert."]},"Birgit":{"l":["Birgit Gelbe führt das Sportgeschäft Sport Schmitz in Wittlich seit acht Jahren.","Birgit Minichmayr als Künstlerin Maria Lassnig im Porträtfilm \"Mit einem Tiger schlafen“.","Haben noch viel vor: Frank Reinert, Christian Büttner und Birgit Diebels-Cavalieri vom Kulturcamp."]},"Birnbaum":{"t":[["Der Birnbaum im Garten trägt reichlich Früchte.","There's plenty of fruit on the pear tree in the garden."],["Der Birnbaum im Garten trägt viele Früchte.","The pear tree in the garden bears a lot of fruit."],["Der Stamm des Birnbaums ist größer als der des Pflaumenbaums.","The trunk of the pear tree is bigger than that of the plum tree."]],"l":["Die Mosers bieten darum ihre gepachtete Wiese mit den Birnbäumen für all jene Rad-Fans an, die sonst nirgends unterkommen würden."]},"Birmanisch":{"t":[["Ich lerne Birmanisch.","I'm learning Burmese."],["Sprichst du birmanisch?","Do you speak Burmese?"],["Sprechen Sie birmanisch?","Do you speak Burmese?"]]},"birken":{"t":[["Im Frühling wird aus den Birken Birkensaft gewonnen.","In spring, sap is extracted from the birch trees."],["In diesem Wald wachsen Eichen, Kiefern und Birken.","Oaks, pines and birches grow in these woods."],["Warum haben Birken weiße Rinden.","Why do birch trees have white bark?"],["Birken haben eine weiße Rinde.","Birch trees have white bark."]],"l":["Die Stadt hat im Wald am Schulbiologiezentrum Hannover Erlen und Birken fällen lassen.","Stadtgrün sei wichtig, allerdings solle man bei Neupflanzungen lieber auf Pollenschleudern wie Birken verzichten.","Besonders der Schacht „Sachsen“ und der umliegende, selbst mit Birken bewachsene Rückstandberg, ein in Deutschland einzigartiges Phänomen, symbolisieren die sensible Verbindung zur Natur."]},"birmanisch":{"t":[["Ich lerne Birmanisch.","I'm learning Burmese."],["Sprichst du birmanisch?","Do you speak Burmese?"],["Sprechen Sie birmanisch?","Do you speak Burmese?"]]},"Birgitz":{"l":["Anschließend sind die Verlegungen bei der Pfarrkirche Birgitz und in Götzens geplant.","Der Recyclinghof in Birgitz im Tiroler Bezirk Innsbruck-Land war am späten Sonntagnachmittag Schauplatz eines Einbruchs."]},"Birkfeld":{"l":["Die „Krone“ fuhr mit dieser historischen Lok ab Birkfeld einen Teil der Strecke mit.","Laut Energie Steiermark sind vor allem in den Regionen Voitsberg und Birkfeld 515 Trafostationen ausgefallen und tausende Haushalte ohne Strom."]},"Birnensaft":{"t":[["Drei Tassen Tee, bitte. Und wir möchten auch ein Glas Birnensaft für unsere Tochter.","Three cups of tea, please. And we would also like a glass of pear juice for our daughter."]],"l":["Aber auch die Geflügelleber, das Rinderhackfleisch oder der Birnensaft werden auf die einzelnen Kochstationen akribisch und nach Vorschrift verteilt."]},"Birkenholz":{"l":["Traditionell wird Mutzbraten über Birkenholz gegrillt, aber Sie können auch eine Räucherbox mit Birkenholzspänen im Gasgrill verwenden, um den authentischen Rauchgeschmack zu erzielen."]},"Birkenstock":{"l":["Diese soll dann die gesamte Unternehmenshistorie abbilden, nicht nur die NS-Zeit, kündigt Birkenstock an.","Ein mögliches Vorbild könnte dabei auch Birkenstock sein.","Zuletzt soll Birkenstock vom \"Barbie\"-Kinofilm profitiert haben."]},"Birkenstocks":{"l":["Die hochwertige Gestaltung durch ein Team aus führenden Buchdesignern und der edle Druck zeugen von BIRKENSTOCKs Bekenntnis zu höchster Qualität und vollendeter Handwerkskunst."]},"Birkenfeld":{"l":["Entscheidung in Birkenfeld: Stadtrat ebnet Weg für das private Freizeitprojekt „Mittelalterdorf“","Kurz nach dem Aufschließen seiner Gaststätte ist ein Wirt in Idar-Oberstein (Kreis Birkenfeld) von zwei maskierten Männern bedroht worden.","Bei einem Unfall auf der B41 bei Birkenfeld wurde in der Nacht zum Mittwoch eine Person verletzt."]}}}