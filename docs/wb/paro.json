 rare subjunctive subjunctive-ii"],["parodieren","indicative plural preterite third-person"],["parodieren","formal plural rare subjunctive subjunctive-ii third-person"],["parodieren","first-person plural preterite third-person"],["parodieren","first-person plural subjunctive-ii third-person"]],"parodiertest":[["parodieren","indicative preterite second-person singular"],["parodieren","formal rare second-person singular subjunctive subjunctive-ii"],["parodieren","preterite second-person singular"],["parodieren","second-person singular subjunctive-ii"]],"parodiertet":[["parodieren","indicative plural preterite second-person"],["parodieren","formal plural rare second-person subjunctive subjunctive-ii"],["parodieren","plural preterite second-person"],["parodieren","plural second-person subjunctive-ii"]],"paronymes":[["Paronym","genitive"],["Paronym","genitive singular"]],"paronyms":[["Paronym","genitive"],["Paronym","genitive singular"]],"paronyme":[["Paronym","plural"],["Paronym","definite nominative plural"],["Paronym","definite genitive plural"],["Paronym","dative singular"],["Paronym","accusative definite plural"]],"paronymen":[["Paronym","dative definite plural"]],"paronymum":[["Paronym","alternative dated"]],"paronymon":[["Paronym","alternative dated"]],"paröken":[["Paröke","genitive"],["Paröke","plural"],["Paröke","definite nominative plural"],["Paröke","genitive singular"],["Paröke","definite genitive plural"],["Paröke","dative definite plural"],["Paröke","accusative definite plural"]]},"x":{"Parole":{"t":[["Die Parole ist „Berg“. Wenn jemand „Berg“ sagt, antwortest du mit „Fluss“.","The password is \"Mountain\". If someone says \"Mountain\", you reply \"River\"."]],"l":["Ihnen konnte nicht nachgewiesen werden, dass sie die rassistischen Parolen mitgesungen hätten.","Teilnehmende einer propalästinensischen Kundgebung am skandierten wiederholt verbotene, israel- und polizeifeindliche Parolen.","Wenige Wochen zuvor grölten auf Sylt Menschen im Champagner-Rausch schlimmste fremdenfeindliche Parolen."]},"Paroxysmus":{"l":["Seit 1999 hat sie 79 schwere Ausbrüche – so genannte Paroxysmen – registriert, von denen sich mehr als 47 nach 2015 ereigneten."]},"Parodie":{"t":[["Die Zeitung druckte eine köstliche Parodie auf die Rede des Präsidenten.","The newspaper published a hilarious parody of the president's speech."],["Er hat eine Parodie eines beliebten Liedes auf seinen Youtubekanal hochgeladen.","He uploaded a parody of a popular song to his YouTube channel."]],"l":["Sie hatte vorher bereits geäussert, dass sie sich als einzig legitime Präsidentin ansieht und die neue Wahl als «Parodie» bezeichnet.","Wie kann man Parodie und Witz glaubhaft den Katastrophen gegenüberstellen, die ständig über die Protagonisten hereinbrechen und denen gegenüber sie ohnmächtig sind?","Sie tanzt wie ihr damals noch wahlkämpfender Großvater, parodiert also seine Parodie, falls es bei ihm eine Parodie war, was nicht auszuschließen ist."]},"Parodontitis":{"l":["Eine unbehandelte Parodontitis verursacht zudem hohe Folgekosten: Allein im zahnärztlichen Bereich summieren sich diese auf rund 200 Mio. Euro jährlich."]},"Paroli":{"l":["Mit seinen Gaudi-KI-Beschleunigern will Intel Nvdia Paroli bieten.","Die Frauen von Borussia Mönchengladbach bieten dem VfL Bochum lange Paroli, verlieren jedoch 2:4.","Im Rückspiel nun wollen Spielertrainer Christoph Holzheu und sein Team besser dagegenhalten und dem Favoriten Paroli bieten."]},"parodieren":{"t":[["Ich bin nicht der reale Tom Hansen; ich parodiere ihn nur.","I'm not the real Tom Jackson; this is a parody."]],"l":["Comedian Matze Knop, der viele Jahre bei Fernsehauftritten parodierte, hat der Fußballlegende posthum gedankt.","Sie tanzt wie ihr damals noch wahlkämpfender Großvater, parodiert also seine Parodie, falls es bei ihm eine Parodie war, was nicht auszuschließen ist.","Keine deutsche Serie wurde so oft ins Ausland verkauft wie der Dauerbrenner, der bis 1998 lief, keine wurde so oft parodiert."]}}}