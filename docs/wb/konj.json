usse":[["Konjunkturzyklus","definite nominative plural"],["Konjunkturzyklus","definite genitive plural"],["Konjunkturzyklus","accusative definite plural"]],"konjunkturzyklussen":[["Konjunkturzyklus","dative definite plural"]],"konjunkturrückgangs":[["Konjunkturrückgang","genitive"],["Konjunkturrückgang","genitive singular"]],"konjunkturrückgange":[["Konjunkturrückgang","plural"],["Konjunkturrückgang","definite nominative plural"],["Konjunkturrückgang","definite genitive plural"],["Konjunkturrückgang","accusative definite plural"]],"konjunkturrückgangen":[["Konjunkturrückgang","dative definite plural"]],"konjunkturaufschwungs":[["Konjunkturaufschwung","genitive"],["Konjunkturaufschwung","genitive singular"]],"konjunkturaufschwunge":[["Konjunkturaufschwung","plural"],["Konjunkturaufschwung","definite nominative plural"],["Konjunkturaufschwung","definite genitive plural"],["Konjunkturaufschwung","accusative definite plural"]],"konjunkturaufschwungen":[["Konjunkturaufschwung","dative definite plural"]],"konjunkturabschwungs":[["Konjunkturabschwung","genitive"],["Konjunkturabschwung","genitive singular"]],"konjunkturabschwunge":[["Konjunkturabschwung","plural"],["Konjunkturabschwung","definite nominative plural"],["Konjunkturabschwung","definite genitive plural"],["Konjunkturabschwung","accusative definite plural"]],"konjunkturabschwungen":[["Konjunkturabschwung","dative definite plural"]],"konjunkturpolitiken":[["Konjunkturpolitik","plural"],["Konjunkturpolitik","definite nominative plural"],["Konjunkturpolitik","definite genitive plural"],["Konjunkturpolitik","dative definite plural"],["Konjunkturpolitik","accusative definite plural"]],"konjakpflanzen":[["Konjakpflanze","plural"],["Konjakpflanze","definite nominative plural"],["Konjakpflanze","definite genitive plural"],["Konjakpflanze","dative definite plural"],["Konjakpflanze","accusative definite plural"]],"konjakwurzeln":[["Konjakwurzel","plural"],["Konjakwurzel","definite nominative plural"],["Konjakwurzel","definite genitive plural"],["Konjakwurzel","dative definite plural"],["Konjakwurzel","accusative definite plural"]]},"x":{"Konjunktiv":{"t":[["Tatsächlich steht dieser Satz im Konjunktiv.","Truth be told, this sentence uses the subjunctive mood."],["Marcel Proust ist bekannt für seine langen Sätze und seine exzessive Verwendung des Konjunktivs.","Marcel Proust is known for his long sentences and his excessive use of the subjunctive."]],"l":["Doch der Konjunktiv bringt den Zürchern die verlorenen Punkte nicht wieder zurück.","Im Konjunktiv sieht das Leben der St. Gallerin ganz anders aus.","Von der Osten spricht bewusst im Konjunktiv."]},"Konjunktion":{"t":[["Wir unterscheiden zwischen nebenordnenden und unterordnenden Konjunktionen.","We distinguish between subordinating and coordinating conjunctions."],["Meiner Erachtens fehlt da eine Konjunktion.","In my opinion, there is a conjunction missing."],["Venus und Jupiter sind in Konjunktion.","Venus and Jupiter are in conjunction."],["Nomen, Pronomen, Verben, Adjektive, Adverbien, Artikel, Präpositionen, Konjunktionen und Interjektionen sind die Wortarten im Englischen.","Nouns, pronouns, verbs, adjectives, adverbs, articles, prepositions, conjunctions, and interjections are the parts of speech in English."]]},"Konjunktur":{"t":[["Wegen der schlechten Konjunktur wurde bei VW die Arbeitswoche um 10 Stunden gekürzt.","As a result of the weak economy, the working week at VW was reduced by 10 hours."]],"l":["Der Eigenbetrieb nimmt an, dass die sich erholende Konjunktur zum Anstieg beiträgt.","Der maue deutsch-chinesische Handel rühre vor allem von der schwächelnden Konjunktur Chinas.","Trotz schwacher Konjunktur und Schwierigkeiten in seinem Automatisierungsgeschäft verzeichnet Siemens einen Rekordgewinn."]},"konjunkturell":{"l":["Der Konzern bleibe vorsichtig, was die konjunkturelle Lage angehe, insbesondere in China.","Stellenabbau, schwache Wirtschaft, trübe konjunkturelle Aussichten – kaum ein Tag vergeht ohne Hiobsbotschaften.","Neben diesen, saisonalen Effekten, kommen laut Silbermann aber noch konjunkturelle Faktoren und Transformationsprozesse."]},"Konjugation":{"t":[["In der russischen Sprache gibt es sehr komplexe Konjugationen.","In the Russian language, conjugation is very complex."],["Welche Konjugationen sind schwieriger: die spanischen oder die französischen?","Which is harder, Spanish or French conjugations?"],["Das ist die falsche Konjugation.","That's the wrong conjugation."],["Die Konjugation ist lustig.","Conjugation is fun."]]},"konjugieren":{"t":[["Kannst du dieses Verb konjugieren?","Can you conjugate this verb?"],["Das Verb \"sein\" wird in allen Sprachen unregelmäßig konjugiert.","The verb “to be” has an irregular conjugation in all languages."],["Ich konjugiere gerne schwierige Verben.","I like to conjugate difficult verbs."],["Gibt es eine Sprache, in der nach dem Genus konjugiert wird?","Is there a language that conjugates based on gender?"]],"l":["Und dass das Wort „fassen“ nur mit A konjugiert wird, war mir damals nicht geläufig."]},"Konjunkturkrise":{"l":["Der Montage- und Befestigungsspezialist bekommt die Konjunkturkrise deutlich zu spüren.","Höhere Zinsen, Inflation, Konjunkturkrise: Die Preise für deutsche Immobilien stehen seit Monaten unter Druck – und die schlechten Nachrichten reißen vorerst nicht ab."]},"Konjunkturaufschwung":{"l":["Neben Large Caps halten weiterhin an Small Caps als Beimischung fest, da niedrige Zinsen und die Möglichkeit eines mittelfristigen Konjunkturaufschwungs gegeben sind."]}}}