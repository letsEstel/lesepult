{"e":{"Vorquartal":[{"p":"noun","g":"n","i":"[ˈfoːɐ̯kvaʁˌtaːl]","a":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/06/De-Vorquartal.ogg/De-Vorquartal.ogg.mp3","s":[["previous quarter",[],[]]],"fm":[["Vorquartals","genitive"],["Vorquartale","plural"],["Vorquartal","nominative singular"],["Vorquartale","definite nominative plural"],["Vorquartals","genitive singular"],["Vorquartale","definite genitive plural"],["Vorquartal","dative singular"],["Vorquartalen","dative definite plural"],["Vorquartal","accusative singular"],["Vorquartale","accusative definite plural"]],"r":10}]},"f":{"vorquartals":[["Vorquartal","genitive"],["Vorquartal","genitive singular"],["Vorquartal","genitive neuter singular"]],"vorquartale":[["Vorquartal","plural"],["Vorquartal","definite nominative plural"],["Vorquartal","definite genitive plural"],["Vorquartal","accusative definite plural"],["Vorquartal","accusative genitive neuter nominative plural"]],"vorquartalen":[["Vorquartal","dative definite plural"],["Vorquartal","dative neuter plural"]]},"x":{"Vorquartal":{"l":["Das Bruttoinlandsprodukt ist Ende letzten Jahres um 5,2 Prozent zum Vorquartal eingebrochen.","Insgesamt stiegen die nominalen Preise für Häuser und Eigentumswohnungen um 0,5 Prozent zum Vorquartal.","Nur zehn Prozent der befragten Unternehmen schätzen die aktuelle Geschäftslage als \"steigend bzw. gut\" ein - analog zum Vorquartal."]}}}