{"e":{"Schkipetar":[{"p":"noun","g":"m","s":[["Albanian (person from Albania)",["obsolete"],[["Die Sprache der Albanesen oder Schkipetaren","The language of the Albanians or Skipetars"]]]],"fm":[["Schkipetaren","genitive"],["Schkipetaren","plural"],["Schkipetarin","feminine"],["Schkipetar","nominative singular"],["Schkipetaren","definite nominative plural"],["Schkipetaren","genitive singular"],["Schkipetaren","definite genitive plural"],["Schkipetaren","dative singular"],["Schkipetaren","dative definite plural"],["Schkipetaren","accusative singular"],["Schkipetaren","accusative definite plural"],["Skipetar","alternative obsolete"]],"et":"Obsolete, replaced by term Albaner. Borrowed from Albanian shqiptar (“Albanian”)."}],"Schkeuditz":[{"p":"name","i":"/ˈʃkɔɪ̯dɪt͡s/","a":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/17/De-Schkeuditz.ogg/De-Schkeuditz.ogg.mp3","s":[["Schkeuditz (a town in northern Saxony, Germany)",[],[]]],"fm":[["Schkeuditz'","genitive"],["Schkeuditz","genitive"],["Schkeuditz","definite nominative singular"],["Schkeuditz'","definite genitive singular"],["Schkeuditz","definite genitive singular"],["Schkeuditz","dative definite singular"],["Schkeuditz","accusative definite singular"]],"r":4}],"Schkopau":[{"p":"name","i":"/ˈʃkoːpaʊ/","s":[["a municipality of Saalekreis district, Saxony-Anhalt, Germany",[],[]]],"fm":[["Schkopaus","genitive"],["Schkopau","genitive with-article"]]}]},"f":{"schkipetar":[["Skipetar","alternative obsolete"]],"schkipetaren":[["Schkipetar","genitive"],["Schkipetar","plural"],["Schkipetar","definite nominative plural"],["Schkipetar","genitive singular"],["Schkipetar","definite genitive plural"],["Schkipetar","dative singular"],["Schkipetar","dative definite plural"],["Schkipetar","accusative singular"]],"schkipetarin":[["Schkipetar","feminine"]],"schkeuditz'":[["Schkeuditz","genitive"],["Schkeuditz","definite genitive singular"]],"schkopaus":[["Schkopau","genitive"]]},"x":{"Schkeuditz":{"l":["Die letzte freie Abfahrt sei demnach die Anschlussstelle Schkeuditz.","In Schkeuditz, Markranstädt und Taucha gibt es zahlreiche Hof- und Bioläden, die regionale Produkte verkaufen.","Reisende am Flughafen-Check-in in Schkeuditz: Passagiere fliegen ab Leipzig besonders gern nach Spanien und in die Türkei."]}}}