zlich","definite feminine genitive includes-article singular weak"],["zusätzlich","definite genitive includes-article neuter singular weak"]],"zusätzlichem":[["zusätzlich","dative masculine singular strong without-article"],["zusätzlich","dative neuter singular strong without-article"],["zusätzlich","dative masculine neuter singular strong"]],"zusatzstoffes":[["Zusatzstoff","genitive"],["Zusatzstoff","genitive singular"]],"zusatzstoffe":[["Zusatzstoff","plural"],["Zusatzstoff","accusative genitive masculine nominative plural"]],"zusatzstoffen":[["Zusatzstoff","dative masculine plural"]],"zusatzartikels":[["Zusatzartikel","genitive"],["Zusatzartikel","genitive singular"]],"zusatzartikeln":[["Zusatzartikel","dative definite plural"]],"zusatzinhaltes":[["Zusatzinhalt","genitive"],["Zusatzinhalt","genitive singular"]],"zusatzinhalts":[["Zusatzinhalt","genitive"],["Zusatzinhalt","genitive singular"]],"zusatzinhalte":[["Zusatzinhalt","plural"],["Zusatzinhalt","definite nominative plural"],["Zusatzinhalt","definite genitive plural"],["Zusatzinhalt","dative singular"],["Zusatzinhalt","accusative definite plural"],["Zusatzinhalt","accusative genitive nominative plural"]],"zusatzinhalten":[["Zusatzinhalt","dative definite plural"],["Zusatzinhalt","dative plural"]],"zusatzfinanzierungen":[["Zusatzfinanzierung","plural"]],"zusatzfaktors":[["Zusatzfaktor","genitive"],["Zusatzfaktor","genitive singular"]],"zusatzfaktoren":[["Zusatzfaktor","plural"],["Zusatzfaktor","definite nominative plural"],["Zusatzfaktor","definite genitive plural"],["Zusatzfaktor","dative definite plural"],["Zusatzfaktor","accusative definite plural"]],"zusatzausrüstungen":[["Zusatzausrüstung","plural"],["Zusatzausrüstung","definite nominative plural"],["Zusatzausrüstung","definite genitive plural"],["Zusatzausrüstung","dative definite plural"],["Zusatzausrüstung","accusative definite plural"]],"zusatzverkaufs":[["Zusatzverkauf","genitive"],["Zusatzverkauf","genitive singular"]],"zusatzverkaufe":[["Zusatzverkauf","plural"],["Zusatzverkauf","definite nominative plural"],["Zusatzverkauf","definite genitive plural"],["Zusatzverkauf","accusative definite plural"]],"zusatzverkaufen":[["Zusatzverkauf","dative definite plural"]]},"x":{"Zusatz":{"t":[["Ich schlage vor, diesen Zusatz zu tilgen.","I suggest paying for these additions."]],"l":["Kaufen würde ich sie nicht, da sie im Supermarkt häufig unerwünschte Zusätze enthalten.","Zusätze wie die Kneipp Aroma-Pflegedusche sorgen dabei für ein besonderes Pflegeerlebnis.","Das ist günstiger, spart Zucker und ist frei von Farbstoffen und anderen unerwünschten Zusätzen."],"b":[["Denn es könnte wohl sein, daß selbst unsere Erfahrungserkenntnis ein Zusammengesetztes aus dem sei, was wir durch Eindrücke empfangen, und dem, was unser eigenes Erkenntnisvermögen (durch sinnliche Eindrücke bloß veranlaßt) aus sich selbst hergibt, welchen Zusatz wir von jenem Grundstoffe nicht eher unterscheiden, als bis lange Übung uns darauf aufmerksam und zur Absonderung desselben geschickt gemacht hat.","因为很可能，即便是我们的经验知识，也是一个复合物：一部分是我们通过印象接受的东西，另一部分是我们自己的认识能力从自身中提供出来的东西（感性印象只是给了它一个契机）。对于这个添加的部分，只要长期的练习还没有让我们注意到它、还没有让我们善于把它分离出来，我们就无法把它和那些基本材料区分开。","kant-krv-einleitung~s-0-5","纯粹理性批判 · 导言（第一、二节）"]]},"zusätzlich":{"t":[["Zusätzliche Informationen findet man auf unserer Website.","One can find additional information on our website."],["Die Lehrerin gab Tom noch zusätzliche Hausaufgaben auf.","The teacher gave Tom extra homework."],["Zusätzlich zu seiner Unwissenheit ist er zu stolz.","Besides being ignorant, he is too proud."],["Es fallen keine zusätzlichen Kosten an.","No additional costs will be incurred."]],"l":["Zusätzlich war sie in der Comedy-Serie „Frau Jordan stellt gleich“ zu sehen.","Zusätzlich wird die Stabilität im Indopazifik und die Beziehungen zu China thematisiert.","Zusätzlich wird es künftig eine Busspur zur Beschleunigung des öffentlichen Verkehrs geben."]},"Zusatzstoff":{"l":["Unter anderem würden Naturpools eine biologische Wasserreinigung ohne desinfizierende Zusatzstoffe bieten.","Mit einem guten Vanilleeis ohne Zusatzstoffe und künstliche gelbe Farbe sowie mit hochwertigem Öl.","Auch ein konventioneller Winzer operiert nicht mit dem Giftschrank, wenn er eine Schönung macht, er wählt seine Zusatzstoffe seriös aus."]},"Zusatzartikel":{"t":[["Der 14. Zusatzartikel der Verfassung der Vereinigten Staaten wurde 1868 ratifiziert.","The 14th Amendment to the U.S. Constitution was ratified in 1868."]],"l":["Das Gesetz verletze ebenfalls nicht das im Fünften Zusatzartikel garantierte Gebot der Gleichbehandlung."]},"Zusatzinhalt":{"l":["Am nächsten Donnerstag gibt es keine zwei Spiele kostenlos, sondern eine Vollversion und einen Zusatzinhalt."]},"Zusatzfinanzierung":{"l":["In Altstetten dürfte sie keine andere Wahl haben, als die städtische Zusatzfinanzierung zu beantragen."]}}}