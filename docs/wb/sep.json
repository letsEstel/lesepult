hs":[["Separatorenfleisch","genitive"],["Separatorenfleisch","genitive singular"]],"separatorenfleische":[["Separatorenfleisch","dative singular"]]},"x":{"September":{"t":[["Schottland kann im September sehr warm sein.","Scotland can be very warm in September."],["Die Strände sind im September weniger überfüllt.","The beaches are less crowded in September."],["Die Schulen öffnen voraussichtlich wieder im September.","Schools are expected to reopen in September."],["Das Finale findet am neunten September statt.","The final takes place on ninth September."]],"l":["Seit September sitzt ein ehemaliger Fußballprofi aus Österreich in Wien in Untersuchungshaft.","Statt im September wird die Brücke nun erst im kommenden Frühjahr fertig.","Ulrike Grosse-Röthig (links) und Christian Schaft im September vorigen Jahres im Gespräch."],"b":[["Königsberg in Preußen, den 30. Septemb. 1784.","普鲁士，柯尼斯堡，1784年9月30日。","kant-aufklaerung~s-10-4","答复这个问题：什么是启蒙？"],["In den Büschingschen Wöchentlichen Nachrichten vom 13. Sept. lese ich heute den 30. ebendess. die Anzeige der Berlinischen Monatsschrift von diesem Monat, worin des Herrn Mendelssohn Beantwortung ebenderselben Frage angeführt wird.","今天，即同月30日，我在9月13日的《比辛周报》上读到《柏林月刊》本月号的预告，其中提到门德尔松先生对同一个问题的答复。","kant-aufklaerung~s-11-0","答复这个问题：什么是启蒙？"]]},"Sephardi":{"t":[["Ich komme aus der Türkei. Ich bin Sephardin. Ich spreche Ladino.","I'm from Turkey. I'm Sephardi. I speak Ladino."]]},"separat":{"t":[["Könnten Sie dies bitte separat einpacken?","Could you please pack this separately?"],["Die Wohnung hat einen separaten Eingang.","The flat has a separate entrance."]],"l":["Trainer Christian Neidhart war jedoch um eine separate Betrachtung der Begegnung bemüht.","Mit der Individualbesteuerung, die beide Ehepartner separat veranlagt, würde sie abgeschafft.","Vorgesehen war gar eine separate Führung von Radfahrenden und motorisiertem Verkehr."]},"separieren":{"l":["Da die Räume der Sparkasse derartig beschädigt worden waren, wird der Zugang zum Kuramt vom Foyer der Bank separiert."]},"separatistisch":{"l":["Vorausgegangen waren die Pro-Europa-Demonstrationen auf dem Maidan in Kiew und die Gründung separatistischer Republiken im Osten der Ukraine.","Was sich schon sagen lässt: Ohne Blick auf den Kampf separatistischer Gruppen in Belutschistan lässt sich diese Krise kaum fassen.","Mit diesem werden die Verantwortlichen für rechtswidrige separatistische Aktionen in Katalonien zwischen 2012 und 2023, einschließlich des schweren Sezessionsversuchs von 2017, begnadigt."]},"Separatist":{"t":[["Die Separatisten haben den Flughafen eingenommen.","The separatists have taken over the airport."]],"l":["Dennoch seien die Aktivitäten der Separatisten eine Gefahr für Ukraine und Moldau.","Zugleich braucht seine in Minderheit regierende Linkskoalition weiter die Unterstützung der Separatisten.","Die sächsische AfD weist jegliche Verbindung mit der rechtsextremen Terrorgruppe „Sächsische Separatisten“ zurück."]},"septisch":{"l":["Im schlimmsten Fall kommt es zum sogenannten septischen Schock und zu Multiorganversagen, was im Tod endet."]},"Sepp":{"t":[["Sepp wirkt abwesend und schaut stundenlang zum Fenster hinaus.","Joe seems absent-minded, spending hours gazing out of the window."],["Wie heißt eigentlich Sepps Freundin? Die hat er uns noch nicht vorgestellt.","What's Joe's girlfriend actually called? He hasn't introduced her to us yet."]],"l":["Auch Corinna Binzer, Sepp Schauer und Daniel Alvarenga werden vor Ort sein.","Der Gastronom Sepp Schellhorn kehrt nach zweieinhalb Jahren zurück aufs politische Parkett.","Nun hat es den Mannheimer Schuhsalon Leone, Alexander Seppel, e.K. erwischt."]},"sephardisch":{"t":[["Das israelische Hebräisch basiert auf der sephardischen Lesetradition.","Israeli Hebrew is based on the Sephardi reading tradition."],["Das Hebräisch Israels basiert auf der sephardischen Lesetradition.","Israeli Hebrew is based on the Sephardi reading tradition."],["Er ist sephardischer Jude.","He's a Sephardic Jew."]]},"Sepsis":{"l":["Bei schweren Verläufen kann es ebenfalls zu einer Sepsis kommen.","Eine Wunde, die sich entzündet, hat, aber auch eine Lungenentzündung oder eine Harnwegsinfektion können zu einer Sepsis führen.","Und 75 Prozent der Überlebenden leiden an teils schweren Spätfolgen, wie die Kampagne „Deutschland erkennt Sepsis“ informiert."]},"Separatorenfleisch":{"l":["Verdacht auf Separatorenfleisch bei Tönnies und Wiesenhof: Was steckt wirklich in unserer Wurst?"]}}}