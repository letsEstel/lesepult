{"e":{"Maoist":[{"p":"noun","g":"m","a":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/97/De-Maoist.ogg/De-Maoist.ogg.mp3","s":[["Maoist",[],[]]],"fm":[["Maoisten","genitive"],["Maoisten","plural"],["Maoistin","feminine"],["Maoist","nominative singular"],["Maoisten","definite nominative plural"],["Maoisten","genitive singular"],["Maoisten","definite genitive plural"],["Maoisten","dative singular"],["Maoisten","dative definite plural"],["Maoisten","accusative singular"],["Maoisten","accusative definite plural"]]}],"Maoismus":[{"p":"noun","g":"m","a":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/2f/De-Maoismus.ogg/De-Maoismus.ogg.mp3","s":[["maoism",[],[]]],"fm":[["Maoismus","genitive"],["Maoismus","nominative singular"],["Maoismus","genitive singular"],["Maoismus","dative singular"],["Maoismus","accusative singular"]]}],"Mao":[{"p":"name","i":"/ˈmaː.o/","s":[["a transliteration of the Chinese surname 毛 (Máo); usually referring to Mao Zedong (in German Mao Tse-tung or rarer Mao Zedong)",[],[]]],"fm":[["Maos","genitive masculine"],["Mao","genitive masculine"],["Mao","feminine genitive"],["Maos","plural"],["Mao","masculine nominative singular"],["Mao","feminine nominative singular"],["Maos","definite nominative plural"],["Maos","genitive masculine singular"],["Mao","genitive masculine singular"],["Mao","feminine genitive singular"],["Maos","definite genitive plural"],["Mao","dative masculine singular"],["Mao","dative feminine singular"],["Maos","dative definite plural"],["Mao","accusative masculine singular"],["Mao","accusative feminine singular"],["Maos","accusative definite plural"]],"et":"Borrowed from Mandarin 毛 (Máo).","r":8}],"Mao-Anzug":[{"p":"noun","g":"m","s":[["Mao suit",[],[]]],"fm":[["Mao-Anzuges","genitive"],["Mao-Anzugs","genitive"],["Mao-Anzüge","plural"]],"et":"Mao (“Mao”) + Anzug (“suit”)"}],"Mao-Bibel":[{"p":"noun","g":"f","i":"/ˈmaːoˌbiːbəl/","s":[["Little Red Book (widely distributed Communist book)",[],[["Ich habe Baader und Ensslin gesagt: Lasst diese Jugendlichen in Ruhe. Daraufhin zückte Baader seine Mao-Bibel und sagte: »Sie sind die Speerspitze des revolutionären Proletariats.«","I told Baader and Ensslin to leave these youths alone. Thereupon Baader pulled out his Little Red Book and said: “They are the spearhead of the revolutionary proletariat.”"]]]],"fm":[["Mao-Bibel","genitive"],["Mao-Bibeln","plural"],["Mao-Bibel","nominative singular"],["Mao-Bibeln","definite nominative plural"],["Mao-Bibel","genitive singular"],["Mao-Bibeln","definite genitive plural"],["Mao-Bibel","dative singular"],["Mao-Bibeln","dative definite plural"],["Mao-Bibel","accusative singular"],["Mao-Bibeln","accusative definite plural"],["Maobibel","alternative"]],"et":"From Mao (“Mao”) + Bibel (“Bible”).","r":1}]},"f":{"maoisten":[["Maoist","genitive"],["Maoist","plural"],["Maoist","definite nominative plural"],["Maoist","genitive singular"],["Maoist","definite genitive plural"],["Maoist","dative singular"],["Maoist","dative definite plural"],["Maoist","accusative singular"]],"maoistin":[["Maoist","feminine"]],"maos":[["Mao","genitive masculine"],["Mao","plural"],["Mao","definite nominative plural"],["Mao","genitive masculine singular"],["Mao","definite genitive plural"],["Mao","dative definite plural"],["Mao","accusative definite plural"]],"mao-anzuges":[["Mao-Anzug","genitive"],["Mao-Anzug","genitive singular"]],"mao-anzugs":[["Mao-Anzug","genitive"],["Mao-Anzug","genitive singular"]],"mao-anzüge":[["Mao-Anzug","plural"],["Mao-Anzug","accusative genitive nominative plural"]],"mao-anzügen":[["Mao-Anzug","dative masculine plural"]],"mao-bibeln":[["Mao-Bibel","plural"],["Mao-Bibel","definite nominative plural"],["Mao-Bibel","definite genitive plural"],["Mao-Bibel","dative definite plural"],["Mao-Bibel","accusative definite plural"]],"maobibel":[["Mao-Bibel","alternative"]]},"x":{"Mao":{"t":[["Mao weiß alles.","Mao knows everything."]],"l":["Gerade dieser trotzige Überlebenskampf in der Einöde hat zu Maos Mythos beigetragen.","Schon Mao wußte: bestrafe einen, erziehe hundert.","Und am 1. Oktober 1949 proklamierte Mao Tse-tung die Volksrepublik China."]},"Mao-Bibel":{"l":["Die Roten Garden, bewaffnet unter anderem mit dem kleinen roten Buch, der Mao-Bibel."]}}}