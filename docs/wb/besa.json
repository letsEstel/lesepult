"plural second-person subjunctive subjunctive-i"]],"besachwalterten":[["besachwaltern","first-person indicative plural preterite"],["besachwaltern","first-person formal plural rare subjunctive subjunctive-ii"],["besachwaltern","indicative plural preterite third-person"],["besachwaltern","formal plural rare subjunctive subjunctive-ii third-person"]],"besachwaltertest":[["besachwaltern","indicative preterite second-person singular"],["besachwaltern","formal rare second-person singular subjunctive subjunctive-ii"]],"besachwaltertet":[["besachwaltern","indicative plural preterite second-person"],["besachwaltern","formal plural rare second-person subjunctive subjunctive-ii"]],"besänftigungen":[["Besänftigung","plural"],["Besänftigung","definite nominative plural"],["Besänftigung","definite genitive plural"],["Besänftigung","dative definite plural"],["Besänftigung","accusative definite plural"]]},"x":{"besänftigen":{"t":[["Das wird den Mob nicht besänftigen.","That won't placate the mob."],["Tom klagt gerne, um die neidischen Nachbarn zu besänftigen.","Tom likes to complain in order to appease his envious neighbors."],["Süßer Kefir besänftigt den Zorn.","Sweet kefir pacifies anger."],["Glaub nicht, dass du mich immer mit Essen besänftigen kannst!","Don't think you'll always be able to placate me with food!"]],"l":["Und eine gute Pflege zu finden, die sie besänftigt, ein schwieriges Unterfangen.","Während die Leihmutter-Agentur das Paar noch besänftigen will, versuchen sie verzweifelt, Oksana zu erreichen.","Alles dreht sich darin um einen boshaften Hasen, der eine Stadt verwüstet – er muss gefangen und besänftigt werden."]},"Besatzung":{"t":[["Moderne Schiffe brauchen nur eine kleine Besatzung.","Modern ships only need a small crew."],["Die Besatzung musste das sinkende Schiff aufgeben.","The crew had to abandon the sinking ship."],["Das Schiff sank mit der gesamten Besatzung.","The ship sank with all the crew."],["Das Schiff sank, und die ganze Besatzung ertrank.","The ship sank and all hands were lost."]],"l":["Deren Besatzungen sollen die Ampeln entlang der Strecke aus dem Weg schaffen.","Diese ist in mehreren Nato-Armeen eingeführt und hat fünf Soldaten als Besatzung.","Dieser konnte von der Besatzung eines Rettungswagens der Rettung Obernberg angehalten werden."]},"Besäufnis":{"t":[["Nach dem Besäufnis der letzten Nacht schläft er jetzt seinen Rausch aus.","He's sleeping off last night's bender."],["Tom sah nach einem dreitägigen Besäufnis aus wie der Tod auf Latschen.","Tom looked like death warmed up after going on a three-day bender."]],"l":["Sie lenkt sich vom Korsett des Hofes mit ekstatischen Besäufnissen mit Ludwig ab."]},"Besatzer":{"l":["IAEA-Beobachter warnen immer wieder vor schlechter Wartung durch die Besatzer.","Sogar dafür werden Menschen von den russischen Besatzern verfolgt.","\"Den größten Schatz\" hätten die Besatzer mitgenommen, hieß es ironisch dazu."]},"besagt":{"t":[["Die Stellungnahme besagte, dass Änderungen notwendig wären.","The statement imported that changes were necessary."],["Das besagt nicht, dass ich bleiben kann.","That doesn't mean I can stay."],["Das besagt nicht unbedingt, dass du recht hast.","It doesn't necessarily mean that you're right."],["Eine neue Studie besagt, daß Kaffee gesund ist.","A new study says that coffee is good for you."]],"l":["Das sei vor besagtem Vorfall bei anderen Begegnungen gewesen, sagte der Anwalt.","Die Polizei informiert, dass das Wenden an der besagten Unfallstelle untersagt ist.","Nach besagtem Auftakt in Doha geht diese am Sonntag in Marrakesch weiter."]},"besaufen":{"t":[["Dafür bin ich gerade wirklich zu besoffen.","I'm really too drunk for this now."],["Bist du wieder besoffen genug zum Deutschsprechen?","Are you drunk enough to speak German once again?"],["Tom war besoffen, als er das gemacht hat.","Tom was drunk when he did that."],["Alle waren besoffen, aber ich nicht.","Everyone was drunk, except for me."]],"l":["\"Es ist ganz komisch: Wenn die Leute besoffen sind, wollen sie alle über Musik reden und gemeinsam jammen.","Dieser sei \"seit immer ohne Job\", habe in der Schule \"versagt\" und sei \"heute um 5.00 Uhr besoffen heimgekommen\"."]},"Besatzungsmacht":{"l":["Der Hass auf die ehemalige Besatzungsmacht ist tief verwurzelt.","Und als Besatzungsmacht hat Israel die Verantwortung für den Schutz und die Versorgung der Zivilbevölkerung.","Es stimmt ja auch, nach Maßgabe des Völkerrechts ist die Besatzungsmacht dazu verpflichtet, die Versorgung der Zivilbevölkerung zu gewährleisten."]},"Besatzungsmitglied":{"t":[["Wie viele Besatzungsmitglieder haben Sie?","How many people are in your crew?"],["Tom und drei andere Besatzungsmitglieder wurden bei dem Unfall verletzt.","Tom and three other crew members were injured in the accident."],["Sind Sie ein Besatzungsmitglied?","Are you a member of this crew?"],["Von 1962 Schiffsreisenden und Besatzungsmitgliedern überlebten nur 764.","Only 764 of the ship's 1,962 passengers and crew survived."]],"l":["Nun verdichten sich Hinweise auf Fehlverhalten von ihm und anderen Besatzungsmitgliedern.","Unter ihnen waren fünf Besatzungsmitglieder, von denen nach letzten Angaben drei ums Leben kamen.","Zwei Besatzungsmitglieder würden vermisst, teilte das Außenministerium am Dienstag mit."]},"besagen":{"t":[["Das besagt nicht, dass ich bleiben kann.","That doesn't mean I can stay."],["Das besagt nicht zwingend, dass Tom tot ist.","This doesn't necessarily mean that Tom is dead."],["Das besagt nicht unbedingt, dass du recht hast.","It doesn't necessarily mean that you're right."],["Eine neue Studie besagt, daß Kaffee gesund ist.","A new study says that coffee is good for you."]],"l":["Die Definition besagt, dass „Aura“ für eine bestimmte besondere Ausstrahlung steht.","Ein weiterer Funkspruch besagt, dass man ein „knackendes Geräusch“ gehört habe.","In der Christnacht sprechen Tiere in der Menschensprache, besagt die Legende."],"b":[["Der politische Betrieb durch Parteien bedeutet eben: Interessentenbetrieb – wir werden bald sehen, was das besagen will.","通过政党进行的政治经营恰恰意味着：利害关系者的经营——这是什么意思，我们很快就会看到。","weber-politik~s-k4-7-1","以政治为业"]]},"Besatzungszone":{"t":[["Deutschland wurde in Besatzungszonen aufgeteilt.","Germany was divided into occupation zones."]],"l":["Das Bundesamt für Verfassungsschutz wurde 1950 in der britischen Besatzungszone gegründet.","Nach der Berlin-Blockade wollten die West-Alliierten den Menschen in den von ihnen kontrollierten Besatzungszonen die Möglichkeit geben, einen Teilstaat zu gründen."]}}}