,["einnisten","formal rare second-person singular subjunctive subjunctive-ii subordinate-clause"]],"einnistetet":[["einnisten","indicative plural preterite second-person subordinate-clause"],["einnisten","formal plural rare second-person subjunctive subjunctive-ii subordinate-clause"]],"einnehmen":[["einnehmen","gerund neuter no-plural strong"]],"einnordend":[["einnorden","participle present"]],"einnorde":[["einnorden","first-person indicative present singular subordinate-clause"],["einnorden","first-person singular subjunctive subjunctive-i subordinate-clause"],["einnorden","singular subjunctive subjunctive-i subordinate-clause third-person"]],"einnordest":[["einnorden","indicative present second-person singular subordinate-clause"],["einnorden","second-person singular subjunctive subjunctive-i subordinate-clause"]],"einnordet":[["einnorden","indicative plural present second-person subordinate-clause"],["einnorden","plural second-person subjunctive subjunctive-i subordinate-clause"],["einnorden","indicative present singular subordinate-clause third-person"]],"einnordete":[["einnorden","first-person indicative preterite singular subordinate-clause"],["einnorden","first-person formal rare singular subjunctive subjunctive-ii subordinate-clause"],["einnorden","indicative preterite singular subordinate-clause third-person"],["einnorden","formal rare singular subjunctive subjunctive-ii subordinate-clause third-person"]],"einnordeten":[["einnorden","first-person indicative plural preterite subordinate-clause"],["einnorden","first-person formal plural rare subjunctive subjunctive-ii subordinate-clause"],["einnorden","indicative plural preterite subordinate-clause third-person"],["einnorden","formal plural rare subjunctive subjunctive-ii subordinate-clause third-person"]],"einnordetest":[["einnorden","indicative preterite second-person singular subordinate-clause"],["einnorden","formal rare second-person singular subjunctive subjunctive-ii subordinate-clause"]],"einnordetet":[["einnorden","indicative plural preterite second-person subordinate-clause"],["einnorden","formal plural rare second-person subjunctive subjunctive-ii subordinate-clause"]],"einnahmenüberschussrechnungen":[["Einnahmenüberschussrechnung","plural"],["Einnahmenüberschussrechnung","definite nominative plural"],["Einnahmenüberschussrechnung","definite genitive plural"],["Einnahmenüberschussrechnung","dative definite plural"],["Einnahmenüberschussrechnung","accusative definite plural"]]},"x":{"einnehmen":{"t":[["Tom will, dass ich seinen Platz einnehme.","Tom wants me to take his place."],["Diese Arznei ist auf leeren Magen einzunehmen.","This medicine is to be taken on an empty stomach."],["Gibt es Medikamente, die Sie regelmäßig einnehmen?","Do you take any medication for any medical issues?"],["Als die Stadt eingenommen war, floh Aeneas.","When the city had been captured, Aeneas fled."]],"l":["Kombiniert mit Auslandsaufenthalten falle es ihr nun aber leicht, andere Perspektiven einzunehmen.","Sinn würde es nur ergeben, wenn alle Einnahmen an die Familien gehen.","WELT-Korrespondent Christoph Wanner sagt: „Die Russen haben zig Dörfer eingenommen im Bereich."],"b":[["Durch einen solchen Beweis von der Macht der Vernunft eingenommen, sieht der Trieb zur Erweiterung keine Grenzen.","被这样一个证明理性力量的例子所吸引，扩展知识的冲动看不到任何边界。","kant-krv~s-e-0-1","纯粹理性批判（选读）"],["Lasset von eurem Erfahrungsbegriffe eines Körpers alles, was daran empirisch ist, nach und nach weg: die Farbe, die Härte oder Weiche, die Schwere, selbst die Undurchdringlichkeit, so bleibt doch der Raum übrig, den er (welcher nun ganz verschwunden ist) einnahm, und den könnt ihr nicht weglassen.","从你们关于一个物体的经验概念中，把一切经验性的东西逐一去掉：颜色、硬或软、重量，甚至不可入性，可是这个物体（现在已经完全消失了）原先占据的空间却依然留下，而这个空间你们是去不掉的。","kant-krv-einleitung~s-1-17","纯粹理性批判 · 导言（第一、二节）"],["Das erste fängt von dem Platze an, den ich in der äußern Sinnenwelt einnehme, und erweitert die Verknüpfung, darin ich stehe, ins unabsehlich Große mit Welten über Welten und Systemen von Systemen, überdem noch in grenzenlose Zeiten ihrer periodischen Bewegung, deren Anfang und Fortdauer.","前者从我在外部感官世界中所占的位置开始，把我所处的联系扩展到不可估量的巨大之中，那里是世界之上的世界、星系之上的星系，而且扩展到它们周期运动的无限时间，它们的开端和延续。","kant-kpv~s-m-1-2","实践理性批判（选读）"]]},"einnehmend":{"t":[["Sein Äußeres ist nicht sehr einnehmend.","His appearance is not exactly captivating."]],"l":["Im Gespräch mit Journalisten wirkt Khan einnehmend und umgänglich.","Werner Güra intoniert den Part des Erzählers mit Ausdruck, sein Tenor hat auch über die Jahre sein einnehmendes Timbre bewahrt."]},"Einnahme":{"t":[["Wir müssen eine Balance zwischen Ausgaben und Einnahmen finden.","We should strike a balance between our expenditure and income."],["Seine Ausgaben liegen bei Weitem höher als seine Einnahmen.","His expenses exceed his income by far."],["Seine großen Einnahmen erlaubten ihm ein Leben in Wohlstand.","His high income afforded him a life of prosperity."],["Die Einnahmen des ersten Monats im Jahre 2011 betrugen mehr als eine Million Yen.","The revenues for the first month of 2011 exceed one million yen."]],"l":["Hinzu kommen deutliche gesunkene Einnahmen aus Exporten von Öl, Gas und Kohle.","Ob die Einnahme eines Nahrungsergänzungsmittels sinnvoll ist, hängt vom im Blut ab.","Sinn würde es nur ergeben, wenn alle Einnahmen an die Familien gehen."],"b":[["Sondern nur dies bedeutet es: daß eine nicht plutokratische Rekrutierung der politischen Interessenten, der Führerschaft und ihrer Gefolgschaft, an die selbstverständliche Voraussetzung gebunden ist, daß diesen Interessenten aus dem Betrieb der Politik regelmäßige und verläßliche Einnahmen zufließen.","它只意味着：要对政治上的有关人员——领导层和他们的追随者——进行非财阀式的招募，就必须有一个不言而喻的前提：这些人能从政治经营中得到定期而可靠的收入。","weber-politik~s-k3-9-4","以政治为业"],["Entweder bezieht er dann Einnahmen aus Gebühren und Sporteln für bestimmte Leistungen – Trinkgelder und Bestechungssummen sind nur eine regellose und formell illegale Abart dieser Kategorie von Einkünften –, oder er bezieht ein festes Naturaliendeputat oder Geldgehalt, oder beides nebeneinander.","他要么从为特定服务收取的规费和手续费中获得收入——小费和贿赂只是这类收入的一种不规则的、形式上非法的变种；要么他领取固定的实物份额或货币薪水，或者两者兼有。","weber-politik~s-k3-10-3","以政治为业"],["Damit jemand in diesem ökonomischen Sinn »für« die Politik leben könne, müssen unter der Herrschaft der Privateigentumsordnung einige, wenn Sie wollen, sehr triviale Voraussetzungen vorliegen: er muß – unter normalen Verhältnissen – ökonomisch von den Einnahmen, welche die Politik ihm bringen kann, unabhängig sein.","为了让一个人能在这种经济意义上「为」政治而活，在私有财产制度的统治下，必须具备一些——如果诸位愿意这么说的话——非常平凡的前提：他必须在正常情况下，在经济上不依赖于政治能给他带来的收入。","weber-politik~s-k3-6-0","以政治为业"]]},"einnicken":{"t":[["Bist du schon mal im Unterricht eingenickt?","Have you ever dozed off in class?"],["Seid ihr schon mal im Unterricht eingenickt?","Have you ever dozed off in class?"],["Sind Sie schon mal im Unterricht eingenickt?","Have you ever dozed off in class?"],["Tom ist während der Sitzung eingenickt.","Tom dozed off during the meeting."]],"l":["Ein Mann ist bei der Autofahrt kurz eingenickt und von der Straße abgekommen.","Nach Einschätzung der Staatsanwaltschaft war der Fahrer damals eingenickt, nach rechts gegen die Leitplanke gefahren, hatte dann nach links gegengelenkt.","Als der Ball noch mal scharf gemacht wird, ist er am zweiten Pfosten komplett blank und kann das Ding einnicken.“"]},"einnässen":{"t":[["Ich habe bis zu meinem zehnten Lebensjahr eingenässt.","I wet the bed until I was ten years old."],["Tom hat sich im Bett eingenässt.","Tom wet the bed."]]},"einnisten":{"l":["Auf seinem Gelände haben sich bereits fünf Cluster eingenistet: Maschinenbau, Werkzeugmaschinenbau, Telekommunikation, Medizin und Logistik.","Die reformatorische Lehre hatte sich im Bürgertum bereits eingenistet.","Ein Hehler hat sich in eine leer stehende Wohnung in Wien-Ottakring eingenistet und dort Diebesgut sowie Drogen gebunkert."]}}}