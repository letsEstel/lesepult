hen":["umdrehen"],"umdreher":["umdrehen"],"umdisponierer":["umdisponieren"]},"x":{"umdrehen":{"t":[["Es ist jetzt zu spät zum Umdrehen.","It's too late to turn back now."],["Umdrehen und mit dem Gesicht zur Wand!","Turn around and face the wall."],["Er hat sich noch nicht einmal umgedreht.","He didn't so much as turn his head."],["Da würde er sich im Grab umdrehen.","That would make him roll over in his grave."]],"l":["Da habe er sich umgedreht und gesehen, wie sein Vater ins Leere fiel.","Ich war so überrascht, dass ich mich umdrehte und auf seine Stiefel pinkelte.","Videos zeigen, wie die Körper berührt, umgedreht, zur Schau gestellt wurden."]},"Umdrehung":{"t":[["Die Turbinen haben eine Drehzahl von 3000 Umdrehungen pro Minute.","The turbines revolve at a speed of 3000 revolutions a minute."],["Die Erde dreht sich um ihre Achse nach Osten – mit einer Umdrehung pro Tag.","Earth rotates eastward on its axis, one complete turn each day."]],"l":["Am Wein ohne Umdrehungen wird ebenfalls seit Jahrzehnten herumgetüftelt, nur noch nicht der Massengeschmack getroffen.","Anders ausgedrückt: Die Bürokratie, unter der gerade Kleinbetriebe ächzen, wird mal wieder eine Umdrehung komplizierter.","Die Saugleistung gibt der Hersteller mit 310 Air-Watt (AW) bei 150.000 Umdrehungen in der Minute an."]},"umdenken":{"t":[["Egal was passiert, ich werde nicht umdenken.","No matter what happens, I won't change my mind."],["Das Zeitalter der Aufklärung führte zu einem Umdenken.","The Age of Enlightenment initiated a change in people's way of thinking."],["Inzwischen hat ein Umdenken begonnen.","Meanwhile a rethink has begun."],["Die Welt muss umdenken.","The world needs to change."]],"l":["Allerdings, so Bortolani-Slongo, erfordere die geänderte Rechtslage ein Umdenken bei den Eltern.","Ich bin nicht wirklich offen für ein Umdenken darüber, wer er ist.","Und er bleibt beim freundlichen Drängen, wenn er sein Publikum zum Umdenken mahnt."]},"umdeuten":{"l":["Ereignisse werden so lange umgedeutet, bis sie ins Konzept passen.","Diesen Kollaps der Nullerjahre, ein Fanal der globalen Geldvernichtung, hat Neo-Burg-Chef Stefan Bachmann in ein Passionsspiel umgedeutet."]},"Umdeutung":{"l":["Indem Putin die Geschichte umschreibt, befördert er doch zusätzlich die kontrafaktische Umdeutung von allem?"]},"umdisponieren":{"t":[["Ich musste umdisponieren.","I had to change my plans."]],"l":["Während das Fleisch für das Gulasch im vergangenen Jahr noch aus dem Mörfelder Oberwald stammte, musste diesmal also umdisponiert werden."]}}}