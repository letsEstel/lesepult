hird-person"],["zergliedern","imperative second-person singular"]],"zerglieder":[["zergliedern","first-person indicative present singular"],["zergliedern","imperative second-person singular"]],"zergliederst":[["zergliedern","indicative present second-person singular"]],"zergliederest":[["zergliedern","second-person singular subjunctive subjunctive-i"]],"zergliedrest":[["zergliedern","second-person singular subjunctive subjunctive-i"]],"zergliederet":[["zergliedern","plural second-person subjunctive subjunctive-i"]],"zergliedret":[["zergliedern","plural second-person subjunctive subjunctive-i"]],"zergliederten":[["zergliedern","first-person indicative plural preterite"],["zergliedern","first-person formal plural rare subjunctive subjunctive-ii"],["zergliedern","indicative plural preterite third-person"],["zergliedern","formal plural rare subjunctive subjunctive-ii third-person"]],"zergliedertest":[["zergliedern","indicative preterite second-person singular"],["zergliedern","formal rare second-person singular subjunctive subjunctive-ii"]],"zergliedertet":[["zergliedern","indicative plural preterite second-person"],["zergliedern","formal plural rare second-person subjunctive subjunctive-ii"]],"zergt":[["zergen","present singular third-person"],["zergen","indicative plural present second-person"],["zergen","indicative present singular third-person"],["zergen","imperative plural second-person"]],"zergte":[["zergen","past"],["zergen","first-person indicative preterite singular"],["zergen","first-person formal rare singular subjunctive subjunctive-ii"],["zergen","indicative preterite singular third-person"],["zergen","formal rare singular subjunctive subjunctive-ii third-person"]],"zergend":[["zergen","participle present"]],"zerge":[["zergen","first-person indicative present singular"],["zergen","first-person singular subjunctive subjunctive-i"],["zergen","singular subjunctive subjunctive-i third-person"],["zergen","imperative second-person singular"]],"zergst":[["zergen","indicative present second-person singular"]],"zergest":[["zergen","second-person singular subjunctive subjunctive-i"]],"zerget":[["zergen","plural second-person subjunctive subjunctive-i"]],"zergten":[["zergen","first-person indicative plural preterite"],["zergen","first-person formal plural rare subjunctive subjunctive-ii"],["zergen","indicative plural preterite third-person"],["zergen","formal plural rare subjunctive subjunctive-ii third-person"]],"zergtest":[["zergen","indicative preterite second-person singular"],["zergen","formal rare second-person singular subjunctive subjunctive-ii"]],"zergtet":[["zergen","indicative plural preterite second-person"],["zergen","formal plural rare second-person subjunctive subjunctive-ii"]],"zerg":[["zergen","imperative second-person singular"]],"zergliedern":[["zergliedern","gerund neuter no-plural strong"]],"zergliederungen":[["Zergliederung","plural"],["Zergliederung","definite nominative plural"],["Zergliederung","definite genitive plural"],["Zergliederung","dative definite plural"],["Zergliederung","accusative definite plural"],["Zergliederung","accusative dative genitive nominative plural"]]},"x":{"zergehen":{"t":[["Dieses Fleisch zergeht auf der Zunge.","This meat is really tender."],["Das Rindfleisch ist sehr zart. Es zergeht einem auf der Zunge.","That beef is very tender. It just melts in your mouth."],["O schmölze doch dies allzu feste Fleisch, zerging und löst’ in einen Tau sich auf!","O that this too too solid flesh would melt, thaw and resolve itself into a dew!"],["Haben Sie schon einmal die Schokolade einfach im Mund zergehen lassen? Ich schwöre, so schmeckt sie noch besser.","Have you ever just let the chocolate melt in your mouth? I swear, it tastes even better this way."]],"l":["Dafür lässt du etwas Butter (ca. 15 g) in einem Topf zergehen und gibst Mehl (ca. 15 g) dazu."]},"zergliedern":{"b":[["Der Begriff von Zwölf ist keineswegs dadurch schon gedacht, daß ich mir bloß jene Vereinigung von Sieben und Fünf denke, und, ich mag meinen Begriff von einer solchen möglichen Summe noch solange zergliedern, so werde ich doch darin die Zwölf nicht antreffen.","我只是想到七和五的结合，「十二」这个概念绝不会因此就已被思维；我尽可以把关于这样一个可能之和的概念分析得再久，在其中也找不到十二。","kant-krv~s-e-3-2","纯粹理性批判（选读）"]]},"Zergliederung":{"b":[["Die ersteren könnte man auch Erläuterungs-, die andern Erweiterungs-Urteile heißen, weil jene durch das Prädikat nichts zum Begriff des Subjekts hinzutun, sondern diesen nur durch Zergliederung in seine Teilbegriffe zerfällen, die in selbigem schon (obgleich verworren) gedacht waren: dahingegen die letzteren zu dem Begriffe des Subjekts ein Prädikat hinzutun, welches in jenem gar nicht gedacht war, und durch keine Zergliederung desselben hätte können herausgezogen werden.","前者也可以叫作说明判断，后者叫作扩展判断。因为前者通过谓词并没有给主词概念增加什么，只是通过分解，把主词概念拆成它的部分概念，而这些部分概念在主词中早已（虽然模糊地）被思维了；相反，后者给主词概念加上一个谓词，这个谓词在主词概念中根本没有被思维，也不可能通过对它的任何分解抽取出来。","kant-krv~s-e-1-3","纯粹理性批判（选读）"]]}}}